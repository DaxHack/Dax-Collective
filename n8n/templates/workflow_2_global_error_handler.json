                  {
                      "parameters":  {
                                         "jsCode":  "// Global Error Handler \u0026 Retry Supervisor\n// Analyzes errors, implements intelligent retry logic, and manages escalation\n\nconst errorData = $input.first();\nconst workflowId = $workflow.id;\nconst executionId = $execution.id;\nconst timestamp = new Date().toISOString();\n\n// Extract error information\nconst errorInfo = {\n  workflowId,\n  executionId,\n  timestamp,\n  nodeName: errorData.node?.name || \u0027Unknown\u0027,\n  nodeType: errorData.node?.type || \u0027Unknown\u0027,\n  errorMessage: errorData.error?.message || \u0027Unknown error\u0027,\n  errorStack: errorData.error?.stack || \u0027\u0027,\n  errorCode: errorData.error?.code || \u0027UNKNOWN\u0027,\n  httpStatusCode: errorData.error?.httpStatusCode || null\n};\n\n// Classify error type and determine retry strategy\nfunction classifyError(error) {\n  const message = error.errorMessage.toLowerCase();\n  const httpCode = error.httpStatusCode;\n  \n  // Rate limiting errors\n  if (httpCode === 429 || message.includes(\u0027rate limit\u0027) || message.includes(\u0027too many requests\u0027)) {\n    return {\n      type: \u0027RATE_LIMIT\u0027,\n      retryable: true,\n      retryDelay: 300000, // 5 minutes\n      maxRetries: 3,\n      escalationLevel: \u0027LOW\u0027\n    };\n  }\n  \n  // Authentication errors\n  if (httpCode === 401 || httpCode === 403 || message.includes(\u0027unauthorized\u0027) || message.includes(\u0027forbidden\u0027)) {\n    return {\n      type: \u0027AUTH_ERROR\u0027,\n      retryable: false,\n      retryDelay: 0,\n      maxRetries: 0,\n      escalationLevel: \u0027HIGH\u0027\n    };\n  }\n  \n  // Network/timeout errors\n  if (httpCode \u003e= 500 || message.includes(\u0027timeout\u0027) || message.includes(\u0027network\u0027) || message.includes(\u0027connection\u0027)) {\n    return {\n      type: \u0027NETWORK_ERROR\u0027,\n      retryable: true,\n      retryDelay: 60000, // 1 minute\n      maxRetries: 5,\n      escalationLevel: \u0027MEDIUM\u0027\n    };\n  }\n  \n  // API quota/limit errors\n  if (message.includes(\u0027quota\u0027) || message.includes(\u0027limit exceeded\u0027)) {\n    return {\n      type: \u0027QUOTA_ERROR\u0027,\n      retryable: true,\n      retryDelay: 3600000, // 1 hour\n      maxRetries: 2,\n      escalationLevel: \u0027MEDIUM\u0027\n    };\n  }\n  \n  // Data/validation errors\n  if (httpCode === 400 || message.includes(\u0027invalid\u0027) || message.includes(\u0027bad request\u0027)) {\n    return {\n      type: \u0027DATA_ERROR\u0027,\n      retryable: false,\n      retryDelay: 0,\n      maxRetries: 0,\n      escalationLevel: \u0027MEDIUM\u0027\n    };\n  }\n  \n  // Default classification\n  return {\n    type: \u0027UNKNOWN_ERROR\u0027,\n    retryable: true,\n    retryDelay: 120000, // 2 minutes\n    maxRetries: 2,\n    escalationLevel: \u0027MEDIUM\u0027\n  };\n}\n\nconst classification = classifyError(errorInfo);\n\n// Get retry history from static data\nconst retryKey = `${workflowId}_${errorInfo.nodeName}_${errorInfo.errorCode}`;\nconst staticData = $workflow.staticData || {};\nconst retryHistory = staticData[retryKey] || { count: 0, lastRetry: null };\n\n// Determine if retry should be attempted\nconst shouldRetry = classification.retryable \u0026\u0026 retryHistory.count \u003c classification.maxRetries;\n\n// Update retry history\nif (shouldRetry) {\n  retryHistory.count += 1;\n  retryHistory.lastRetry = timestamp;\n  staticData[retryKey] = retryHistory;\n}\n\n// Create comprehensive error report\nconst errorReport = {\n  ...errorInfo,\n  classification,\n  retryHistory,\n  shouldRetry,\n  nextRetryAt: shouldRetry ? new Date(Date.now() + classification.retryDelay).toISOString() : null,\n  escalationRequired: !shouldRetry || classification.escalationLevel === \u0027HIGH\u0027\n};\n\nreturn errorReport;"
                                     },
