                      "id":  "1",
                      "name":  "Daily Faith Content Trigger",
                      "type":  "n8n-nodes-base.cron",
                      "typeVersion":  1,
                      "position":  [
                                       240,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "model":  "gpt-4",
                                         "messages":  {
                                                          "messageType":  "multipleMessages",
                                                          "messages":  [
                                                                           {
                                                                               "role":  "system",
                                                                               "message":  "You are a faith-based content creator for God\u0027s Vessel, focused on inspiring biblical content, daily devotionals, and Christian living guidance. Your content should be encouraging, biblically sound, and accessible to believers at all stages of their faith journey."
                                                                           },
                                                                           {
                                                                               "role":  "user",
                                                                               "message":  "Generate a faith-based video concept for today\u0027s devotional content. Consider:\n\nCurrent date: {{ $now.format(\u0027MMMM Do, YYYY\u0027) }}\nDay of week: {{ $now.format(\u0027dddd\u0027) }}\nSeason: {{ $now.format(\u0027MMMM\u0027) }}\nUpcoming Christian holidays: {{ $json.christian_calendar }}\n\nCreate:\n1. Inspiring video title (6-10 words, hope-focused)\n2. Video description with biblical foundation\n3. Key scripture passage and application points\n4. Practical faith application for daily life\n5. Prayer focus and call-to-action\n6. Merchandise integration opportunities (faith-based apparel)\n7. Target 5-8 minute inspirational format\n\nFocus on authentic encouragement that helps viewers grow in their relationship with God and live out their faith practically."
                                                                           }
                                                                       ]
                                                      },
                                         "options":  {
                                                         "temperature":  0.7,
                                                         "maxTokens":  1500
                                                     }
                                     },
                      "id":  "2",
                      "name":  "Generate Faith Video Concept",
                      "type":  "@n8n/n8n-nodes-langchain.openAi",
                      "typeVersion":  1,
                      "position":  [
                                       460,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "model":  "gpt-4",
                                         "messages":  {
                                                          "messageType":  "multipleMessages",
                                                          "messages":  [
                                                                           {
                                                                               "role":  "system",
                                                                               "message":  "You are creating a faith-based devotional script. Write with warmth, authenticity, and biblical wisdom. Include personal reflection, practical application, and encouragement that feels like a conversation with a trusted friend in faith."
                                                                           },
                                                                           {
                                                                               "role":  "user",
                                                                               "message":  "Create a devotional script for this faith concept:\n\n{{ $json.video_concept }}\n\nScript structure:\n1. Warm greeting and introduction (15-30 seconds)\n2. Scripture reading with context (1 minute)\n3. Biblical teaching and explanation (2-4 minutes)\n4. Personal application and reflection (1-2 minutes)\n5. Prayer and God\u0027s Vessel merchandise mention (30 seconds)\n6. Closing encouragement and subscribe reminder (30 seconds)\n\nInclude markers:\n- [PAUSE] for reflective moments\n- [EMPHASIS] for key biblical truths\n- [VISUAL: description] for scripture graphics or imagery\n- [PRAYER] for prayer segments\n- [MERCHANDISE] for natural product integration\n\nMaintain a conversational, encouraging tone that builds faith and provides practical guidance for Christian living."
                                                                           }
                                                                       ]
                                                      },
                                         "options":  {
                                                         "temperature":  0.6,
                                                         "maxTokens":  2500
                                                     }
                                     },
                      "id":  "3",
                      "name":  "Create Faith Script",
                      "type":  "@n8n/n8n-nodes-langchain.openAi",
                      "typeVersion":  1,
                      "position":  [
                                       680,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// Process faith script for audio generation\nconst script = $input.first().json.script;\n\n// Clean script for text-to-speech\nlet cleanScript = script\n  .replace(/\\[PAUSE\\]/g, \u0027... \u0027)\n  .replace(/\\[EMPHASIS\\]/g, \u0027\u0027)\n  .replace(/\\[VISUAL:.*?\\]/g, \u0027\u0027)\n  .replace(/\\[PRAYER\\]/g, \u0027\u0027)\n  .replace(/\\[MERCHANDISE\\]/g, \u0027\u0027)\n  .replace(/\\[.*?\\]/g, \u0027\u0027)\n  .replace(/\\s+/g, \u0027 \u0027)\n  .trim();\n\n// Extract scripture references\nconst scriptureRefs = [];\nconst scriptureMatches = script.match(/\\b\\d*\\s*[A-Za-z]+\\s+\\d+:\\d+(-\\d+)?\\b/g);\nif (scriptureMatches) {\n  scriptureRefs.push(...scriptureMatches);\n}\n\n// Extract visual cues for graphics\nconst visualCues = [];\nconst visualMatches = script.match(/\\[VISUAL:(.*?)\\]/g);\nif (visualMatches) {\n  visualMatches.forEach(match =\u003e {\n    const cue = match.replace(/\\[VISUAL:|\\]/g, \u0027\u0027).trim();\n    visualCues.push(cue);\n  });\n}\n\n// Extract prayer segments\nconst prayerSegments = [];\nconst prayerMatches = script.match(/\\[PRAYER\\](.*?)(?=\\[|$)/gs);\nif (prayerMatches) {\n  prayerMatches.forEach(match =\u003e {\n    const prayer = match.replace(/\\[PRAYER\\]/g, \u0027\u0027).trim();\n    if (prayer) prayerSegments.push(prayer);\n  });\n}\n\n// Generate keywords for faith-based imagery\nconst faithKeywords = [\n  \u0027cross\u0027, \u0027bible\u0027, \u0027prayer\u0027, \u0027faith\u0027, \u0027hope\u0027, \u0027peace\u0027,\n  \u0027worship\u0027, \u0027church\u0027, \u0027christian\u0027, \u0027spiritual\u0027, \u0027blessed\u0027,\n  \u0027grace\u0027, \u0027salvation\u0027, \u0027jesus\u0027, \u0027god\u0027, \u0027holy\u0027\n];\n\nreturn {\n  script_clean: cleanScript,\n  script_original: script,\n  scripture_references: scriptureRefs,\n  visual_cues: visualCues,\n  prayer_segments: prayerSegments,\n  visual_keywords: faithKeywords.join(\u0027 \u0027),\n  word_count: cleanScript.split(\u0027 \u0027).length\n};"
                                     },
                      "id":  "4",
                      "name":  "Process Faith Script",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       900,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "voice":  "{{ $env.GODS_VESSEL_VOICE_ID }}",
                                         "text":  "{{ $json.script_clean }}",
                                         "model":  "eleven_multilingual_v2",
                                         "voice_settings":  {
                                                                "stability":  0.85,
                                                                "similarity_boost":  0.8,
                                                                "style":  0.2
                                                            }
                                     },
