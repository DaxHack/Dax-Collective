                      "parameters":  {
                                         "jsCode":  "const enabled = $env.DAX_ENABLE_PUBLIC_PUBLISHING === \u0027true\u0027;\nconst approvedValues = [\u0027approved_for_publish\u0027, \u0027approved\u0027, \u0027ready_to_publish\u0027];\nreturn $input.all().filter((item) =\u003e {\n  const data = item.json || {};\n  const approved = data.approvedForPublish === true || approvedValues.includes(data.reviewStatus) || approvedValues.includes(data.review_status) || approvedValues.includes(data.approvalStatus);\n  return enabled \u0026\u0026 approved;\n}).map((item) =\u003e {\n  item.json.daxPublishingGuard = { passed: true, checkedAt: new Date().toISOString(), targetNode: \u0027Upload Faith Video\u0027 };\n  return item;\n});"
                                     },
