# =============================================================================
# dax-main — FRONTEND ENVIRONMENT TEMPLATE
# =============================================================================
# Copy this file to .env and fill in values for local development.
# NEVER commit your real .env file.
#
# WARNING: Every variable prefixed REACT_APP_ is embedded in the browser
# JavaScript bundle at build time. Do NOT put secrets here — no client
# secrets, refresh tokens, private keys, or backend-only API keys.
# Those belong in dax-backend/.env only.
# =============================================================================


# ─── DEV SERVER ──────────────────────────────────────────────────────────────
NODE_ENV=development


# ─── BACKEND API BASE URL ─────────────────────────────────────────────────────
# URL of the dax-backend Express server. Used by all frontend service calls.
REACT_APP_API_BASE_URL=http://localhost:5000
REACT_APP_FIREBASE_FUNCTIONS_URL=http://localhost:5001/dax-collective/us-central1


# ─── FIREBASE CLIENT CONFIG (browser-safe public config) ─────────────────────
# These are public identifiers — they are NOT secret.
# Firebase security is enforced by Firestore rules, not by hiding these values.
REACT_APP_FIREBASE_API_KEY=your-firebase-web-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
REACT_APP_FIREBASE_APP_ID=your-firebase-app-id
REACT_APP_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX


# ─── GOOGLE APIS (browser-visible — use only restricted, low-risk keys) ───────
# Use keys restricted by HTTP referrer in Google Cloud Console.
# Do NOT put unrestricted server keys or OAuth client secrets here.
REACT_APP_GOOGLE_API_KEY=your-restricted-browser-api-key
REACT_APP_GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
REACT_APP_GOOGLE_DRIVE_API_KEY=your-restricted-drive-api-key
REACT_APP_GOOGLE_SHEETS_API_KEY=your-restricted-sheets-api-key
REACT_APP_GOOGLE_MAPS_KEY=your-restricted-maps-api-key


# ─── YOUTUBE (public channel IDs + restricted API key) ───────────────────────
# YouTube API key here should be restricted by referrer.
# Prefer routing YouTube requests through the backend API instead.
REACT_APP_YOUTUBE_API_KEY=your-restricted-youtube-api-key
REACT_APP_YOUTUBE_CHANNEL_ID_DAX_TRAVELER=UCuN9RFxD1_PUOci_AEa5DMQ
REACT_APP_YOUTUBE_CHANNEL_ID_TIMEZONE_TRAVELERS=UCKan3hAUmcy0Q49d7MIXhdA
REACT_APP_YOUTUBE_CHANNEL_ID_SATIATED_TASTE=UCmlTPphxXdZ3T2gDQ_kPZQQ
REACT_APP_YOUTUBE_CHANNEL_ID_GODS_VESSEL=UCAzuegEphw7oQRarESOjuqA
REACT_APP_YT_CHANNEL_ID_TIMEZONE_TRAVELERS=UCKan3hAUmcy0Q49d7MIXhdA


# ─── GOOGLE DRIVE FOLDER IDs (public read-only folder IDs) ───────────────────
# These are folder IDs, not secrets. Still prefer proxying through backend.
REACT_APP_DRIVE_DAX_TRAVELER_PHOTOS=your-dax-traveler-folder-id
REACT_APP_DRIVE_GODS_VESSEL_PHOTOS=your-gods-vessel-folder-id
REACT_APP_DRIVE_TIMEZONE_TRAVELERS_PHOTOS=your-timezone-travelers-folder-id
REACT_APP_DRIVE_SATIATED_TASTE_PHOTOS=your-satiated-taste-folder-id
REACT_APP_DRIVE_ANI_DAX_PHOTOS=your-ani-dax-folder-id
REACT_APP_DRIVE_DAX_HOMEPAGE_PHOTOS=your-dax-homepage-folder-id
REACT_APP_DRIVE_DAX_ANALYTICS_IMAGES=your-analytics-images-folder-id
REACT_APP_DRIVE_BRAND_ASSETS=your-brand-assets-folder-id
REACT_APP_DRIVE_LOGO_ASSETS=your-logo-assets-folder-id
REACT_APP_DRIVE_YOUTUBE_THUMBNAILS=your-thumbnails-folder-id
REACT_APP_DRIVE_SOCIAL_MEDIA_ASSETS=your-social-media-folder-id
REACT_APP_DRIVE_TSHIRT_DESIGNS=your-tshirt-designs-folder-id
REACT_APP_DRIVE_BLOG_IMAGES=your-blog-images-folder-id
REACT_APP_DRIVE_ARCHIVE_PHOTOS=your-archive-photos-folder-id
REACT_APP_DRIVE_BACKUP_PHOTOS=your-backup-photos-folder-id
REACT_APP_DRIVE_FOLDER_TRAVEL=your-drive-travel-folder-id
REACT_APP_DRIVE_FOLDER_FAITH=your-drive-faith-folder-id
REACT_APP_DRIVE_FOLDER_COLLECTIVE=your-drive-collective-folder-id
REACT_APP_DRIVE_FOLDER_TIMEZONE=your-drive-timezone-folder-id


# ─── GOOGLE SHEETS IDs (public sheet IDs for read-only frontend access) ──────
# Sheet IDs are not secrets, but sheets must have public read access enabled.
REACT_APP_SHEET_DAX_TRAVELER_BLOGS=your-dax-traveler-blogs-sheet-id
REACT_APP_SHEET_BRAND_ANALYTICS_DASHBOARD=your-brand-analytics-sheet-id
REACT_APP_SHEET_TIMEZONE_TRAVELERS_BLOGS_ITINERARIES=your-timezone-itineraries-sheet-id
REACT_APP_SHEET_GODS_VESSEL_DISCUSSIONS=your-gods-vessel-discussions-sheet-id
REACT_APP_SHEET_GODS_VESSEL_QUOTES=your-gods-vessel-quotes-sheet-id
REACT_APP_SHEET_TSHIRT_DESIGNS_CANVA_BULK=your-tshirt-designs-sheet-id
REACT_APP_SHEET_SATIATED_TASTE_RECIPES=your-satiated-taste-recipes-sheet-id
REACT_APP_SHEET_SOCIAL_TRACKING_YOUTUBE=your-social-tracking-youtube-sheet-id
REACT_APP_SHEET_SOCIAL_TRACKING_INSTAGRAM=your-social-tracking-instagram-sheet-id
REACT_APP_SHEET_SOCIAL_TRACKING_TIKTOK=your-social-tracking-tiktok-sheet-id
REACT_APP_SHEET_SOCIAL_TRACKING_TWITTER=your-social-tracking-twitter-sheet-id
REACT_APP_SHEET_SOCIAL_TRACKING_FACEBOOK=your-social-tracking-facebook-sheet-id


# ─── ANALYTICS (public measurement IDs) ──────────────────────────────────────
REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX
REACT_APP_MIXPANEL_TOKEN=your-mixpanel-project-token
REACT_APP_HOTJAR_SITE_ID=your-hotjar-site-id


# ─── STOCK PHOTO APIS (browser-visible read keys) ────────────────────────────
# These providers allow browser-side API usage with public access keys.
REACT_APP_UNSPLASH_ACCESS_KEY=your-unsplash-access-key
REACT_APP_PEXELS_API_KEY=your-pexels-api-key
REACT_APP_PIXABAY_API_KEY=your-pixabay-api-key


# ─── SOCIAL — PUBLIC IDs ONLY ────────────────────────────────────────────────
# Only non-secret public identifiers belong here.
# App secrets, access tokens, and client secrets must live in dax-backend/.env.
REACT_APP_REDDIT_CLIENT_ID=your-reddit-public-client-id
REACT_APP_REDDIT_SUBREDDIT_DAX_TRAVELER=travel,backpacking,solotravel
REACT_APP_REDDIT_SUBREDDIT_TIMEZONE_TRAVELERS=productivity,timemanagement,remotework
REACT_APP_REDDIT_SUBREDDIT_SATIATED_TASTE=food,cooking,recipes
REACT_APP_REDDIT_SUBREDDIT_GODS_VESSEL=christianity,faith,spirituality
REACT_APP_TWITTER_API_KEY=your-twitter-public-api-key


# ─── VOICE IDs (ElevenLabs voice IDs — not secrets, just identifiers) ────────
REACT_APP_VOICE_ID_DAX_TRAVELER=your-elevenlabs-voice-id
REACT_APP_VOICE_ID_TIMEZONE_TRAVELERS=your-elevenlabs-voice-id
REACT_APP_VOICE_ID_SATIATED_TASTE=your-elevenlabs-voice-id
REACT_APP_VOICE_ID_GODS_VESSEL=your-elevenlabs-voice-id


# ─── CONTACT / EMAIL (public-facing addresses) ───────────────────────────────
REACT_APP_EMAIL_MAIN=contact@yourdomain.com
REACT_APP_EMAIL_DAX_TRAVELER=daxtraveler@yourdomain.com
REACT_APP_EMAIL_TIMEZONE_TRAVELERS=timezone@yourdomain.com
REACT_APP_EMAIL_SATIATED_TASTE=satiated@yourdomain.com
REACT_APP_EMAIL_GODS_VESSEL=godsvesseel@yourdomain.com
REACT_APP_EMAIL_SUPPORT=support@yourdomain.com
REACT_APP_EMAIL_BUSINESS=business@yourdomain.com


# ─── FEATURE FLAGS & DEBUG ────────────────────────────────────────────────────
REACT_APP_DEBUG=false
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_SERVICE_WORKER=true
REACT_APP_ENABLE_DEBUG_LOGS=false
REACT_APP_API_TIMEOUT=30000


# ─── n8n WEBHOOK URLs (public webhook endpoints only — NOT the API key) ───────
# WARNING: REACT_APP_N8N_API_KEY exposes your n8n admin key to the browser.
# Move n8n authenticated calls to the backend. Only use public webhook URLs here.
REACT_APP_N8N_WEBHOOK_URL=http://localhost:5678
REACT_APP_N8N_WEBHOOK_CONTENT_GENERATION=your-n8n-content-webhook-url
REACT_APP_N8N_WEBHOOK_SOCIAL_DISTRIBUTION=your-n8n-social-webhook-url
REACT_APP_N8N_WEBHOOK_YOUTUBE_SYNC=your-n8n-youtube-webhook-url
REACT_APP_N8N_WEBHOOK_REVENUE_OPTIMIZATION=your-n8n-revenue-webhook-url
# REACT_APP_N8N_API_KEY=              ← REMOVED: exposes n8n API key to browser
#                                        Move authenticated n8n calls to backend.


# ─── BROWSER-VISIBLE AI API KEYS — FUTURE MIGRATION REQUIRED ─────────────────
# The following were referenced in src/config/apiConfig.js as REACT_APP_ vars.
# This exposes these keys in the JavaScript bundle delivered to every visitor.
# They are listed here commented-out as a migration reminder only.
# Route these calls through dax-backend instead and use backend-only keys.
#
# REACT_APP_OPENAI_API_KEY=          ← DANGEROUS: Move to backend OPENAI_API_KEY
# REACT_APP_ELEVENLABS_API_KEY=      ← DANGEROUS: Move to backend ELEVENLABS_API_KEY
# REACT_APP_INSTAGRAM_ACCESS_TOKEN=  ← DANGEROUS: Move to backend INSTAGRAM_ACCESS_TOKEN
