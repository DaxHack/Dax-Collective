                      "id":  "youtube-monitor-trigger",
                      "name":  "Monitor Every 15 Minutes",
                      "type":  "n8n-nodes-base.scheduleTrigger",
                      "typeVersion":  1.1,
                      "position":  [
                                       240,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// YouTube Sentinel Agent\n// Monitors all brand channels for new uploads and triggers content generation\n\nconst channels = [\n  {\n    id: $env.DAX_TRAVELER_CHANNEL_ID,\n    name: \u0027Dax The Traveler\u0027,\n    brand: \u0027dax_traveler\u0027,\n    enabled: $env.BRAND_DAX_TRAVELER_ENABLED === \u0027true\u0027\n  },\n  {\n    id: $env.GODS_VESSEL_CHANNEL_ID,\n    name: \"God\u0027s Vessel\",\n    brand: \u0027gods_vessel\u0027,\n    enabled: $env.BRAND_GODS_VESSEL_ENABLED === \u0027true\u0027\n  },\n  {\n    id: $env.TIMEZONE_TRAVELERS_CHANNEL_ID,\n    name: \u0027Time-Zone Travelers\u0027,\n    brand: \u0027timezone_travelers\u0027,\n    enabled: $env.BRAND_TIMEZONE_TRAVELERS_ENABLED === \u0027true\u0027\n  },\n  {\n    id: $env.ANI_DAX_CHANNEL_ID,\n    name: \u0027Ani-Dax\u0027,\n    brand: \u0027ani_dax\u0027,\n    enabled: $env.BRAND_ANI_DAX_ENABLED === \u0027true\u0027\n  }\n];\n\n// Filter enabled channels\nconst enabledChannels = channels.filter(channel =\u003e channel.enabled \u0026\u0026 channel.id);\n\nreturn enabledChannels.map(channel =\u003e ({\n  channelId: channel.id,\n  channelName: channel.name,\n  brand: channel.brand,\n  apiKey: $env.YOUTUBE_API_KEY\n}));"
                                     },
