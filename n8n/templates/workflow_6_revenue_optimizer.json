                      "id":  "split-revenue-sources",
                      "name":  "Analyze Each Revenue Source",
                      "type":  "n8n-nodes-base.splitInBatches",
                      "typeVersion":  3,
                      "position":  [
                                       680,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// Configure revenue source analysis\nconst revenueData = $(\u0027Prepare Revenue Analysis\u0027).first();\nconst currentSource = revenueData.enabledSources[$(\u0027Analyze Each Revenue Source\u0027).itemIndex];\n\nif (!currentSource) {\n  return null;\n}\n\nconst sourceConfig = revenueData.revenueSources[currentSource];\nconst targetRevenue = revenueData.currentTarget * revenueData.revenueTargets.breakdown[currentSource] || 0;\n\n// Generate API calls based on source type\nconst apiConfig = {\n  patreon: {\n    url: `https://www.patreon.com/api/oauth2/v2/campaigns/${sourceConfig.campaignId}?include=tiers,benefits,goals\u0026fields%5Bcampaign%5D=creation_name,patron_count,pledge_sum`,\n    headers: {\n      \u0027Authorization\u0027: `Bearer ${sourceConfig.apiKey}`,\n      \u0027Content-Type\u0027: \u0027application/json\u0027\n    }\n  },\n  shopify: {\n    url: `https://${sourceConfig.shopDomain}.myshopify.com/admin/api/2023-10/orders.json?status=any\u0026limit=250\u0026created_at_min=${new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString()}`,\n    headers: {\n      \u0027X-Shopify-Access-Token\u0027: sourceConfig.apiKey,\n      \u0027Content-Type\u0027: \u0027application/json\u0027\n    }\n  },\n  printify: {\n    url: `https://api.printify.com/v1/shops/${sourceConfig.shopId}/orders.json?page=1\u0026limit=100`,\n    headers: {\n      \u0027Authorization\u0027: `Bearer ${sourceConfig.apiKey}`,\n      \u0027Content-Type\u0027: \u0027application/json\u0027\n    }\n  },\n  youtube: {\n    url: `https://www.googleapis.com/youtube/v3/channels?part=statistics\u0026id=${sourceConfig.channels.map(c =\u003e c.id).join(\u0027,\u0027)}\u0026key=${sourceConfig.apiKey}`,\n    headers: {\n      \u0027Content-Type\u0027: \u0027application/json\u0027\n    }\n  },\n  affiliates: {\n    // Custom tracking - would need specific affiliate network APIs\n    url: null,\n    headers: {}\n  }\n};\n\nreturn {\n  source: currentSource,\n  sourceConfig,\n  targetRevenue,\n  apiConfig: apiConfig[currentSource],\n  analysisTimestamp: revenueData.analysisTimestamp\n};"
                                     },
