# ─── dax-main (React frontend) .gitignore ──────────────────────────────────
# Root .gitignore handles most rules. This file adds frontend-specific ignores.

# ─── DEPENDENCIES ──────────────────────────────────────────────────────────
/node_modules/
/.pnp
.pnp.js

# ─── BUILD ─────────────────────────────────────────────────────────────────
/build/
/dist/
/.next/
/out/

# ─── ENV FILES ─────────────────────────────────────────────────────────────
# REACT_APP_ variables are baked into the browser bundle at build time.
# Never commit real values. Only .env.example (placeholders only) is tracked.
.env
.env.local
.env.development
.env.production
.env.test
.env.*
!.env.example

# ─── FIREBASE / CLOUD ──────────────────────────────────────────────────────
.firebaserc
.firebase/
/keys/
*.key
*.pem

# ─── CACHES ────────────────────────────────────────────────────────────────
.cache/
.tmp/
.eslintcache
/coverage/
/jest-coverage/

# ─── RUNTIME TEMP ──────────────────────────────────────────────────────────
src/temp/

# ─── LOGS ──────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
*.tmp
*.bak

# ─── DATABASE DUMPS ────────────────────────────────────────────────────────
*.sqlite
*.db
dump.rdb

# ─── IDE & OS ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
