                      "id":  "split-platforms",
                      "name":  "Process Each Platform",
                      "type":  "n8n-nodes-base.splitInBatches",
                      "typeVersion":  3,
                      "position":  [
                                       680,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// Generate platform-specific content using AI\nconst contentData = $(\u0027Prepare Content Data\u0027).first();\nconst currentPlatform = contentData.strategy.platforms[$(\u0027Process Each Platform\u0027).itemIndex];\n\nif (!currentPlatform) {\n  return null;\n}\n\n// Platform-specific content requirements\nconst platformSpecs = {\n  instagram: {\n    maxLength: 2200,\n    format: \u0027visual-first\u0027,\n    hashtagLimit: 30,\n    includeEmojis: true,\n    callToAction: true\n  },\n  facebook: {\n    maxLength: 63206,\n    format: \u0027engaging-story\u0027,\n    hashtagLimit: 5,\n    includeEmojis: true,\n    callToAction: true\n  },\n  twitter: {\n    maxLength: 280,\n    format: \u0027concise-thread\u0027,\n    hashtagLimit: 3,\n    includeEmojis: true,\n    callToAction: false\n  },\n  linkedin: {\n    maxLength: 3000,\n    format: \u0027professional\u0027,\n    hashtagLimit: 5,\n    includeEmojis: false,\n    callToAction: true\n  },\n  tiktok: {\n    maxLength: 2200,\n    format: \u0027trendy-engaging\u0027,\n    hashtagLimit: 10,\n    includeEmojis: true,\n    callToAction: true\n  },\n  pinterest: {\n    maxLength: 500,\n    format: \u0027descriptive-seo\u0027,\n    hashtagLimit: 20,\n    includeEmojis: false,\n    callToAction: true\n  },\n  reddit: {\n    maxLength: 40000,\n    format: \u0027community-discussion\u0027,\n    hashtagLimit: 0,\n    includeEmojis: false,\n    callToAction: false\n  },\n  blog: {\n    maxLength: 10000,\n    format: \u0027comprehensive-article\u0027,\n    hashtagLimit: 10,\n    includeEmojis: false,\n    callToAction: true\n  }\n};\n\nconst spec = platformSpecs[currentPlatform];\n\n// Create AI prompt for content generation\nfunction createContentPrompt(videoData, platform, spec, strategy) {\n  const basePrompt = `Generate ${platform} content based on this YouTube video:\n\nTitle: ${videoData.title}\nBrand: ${videoData.brand}\nKeywords: ${videoData.keywords.join(\u0027, \u0027)}\nTopics: ${videoData.topics.join(\u0027, \u0027)}\nTranscript excerpt: ${videoData.transcript.substring(0, 500)}...\n\nBrand Strategy:\n- Tone: ${strategy.tone}\n- Target hashtags: ${strategy.hashtags.join(\u0027, \u0027)}\n- Call to action: ${strategy.cta}\n\nPlatform Requirements:\n- Max length: ${spec.maxLength} characters\n- Format: ${spec.format}\n- Hashtag limit: ${spec.hashtagLimit}\n- Include emojis: ${spec.includeEmojis}\n- Include CTA: ${spec.callToAction}\n\n`;\n\n  const platformInstructions = {\n    instagram: \u0027Create an engaging Instagram post with visual storytelling. Include relevant emojis and hashtags. Focus on the visual aspect and encourage engagement.\u0027,\n    facebook: \u0027Write a compelling Facebook post that tells a story and encourages discussion. Use a conversational tone and include a clear call to action.\u0027,\n    twitter: \u0027Create a Twitter thread (if needed) that captures the key points concisely. Use trending hashtags and encourage retweets.\u0027,\n    linkedin: \u0027Write a professional LinkedIn post that provides value and insights. Focus on lessons learned and professional development aspects.\u0027,\n    tiktok: \u0027Create TikTok caption that\\\u0027s trendy and engaging. Include popular hashtags and encourage user interaction.\u0027,\n    pinterest: \u0027Write a Pinterest description that\\\u0027s SEO-optimized and descriptive. Focus on searchable keywords and visual appeal.\u0027,\n    reddit: \u0027Create a Reddit post that encourages community discussion. Be authentic and provide value to the community.\u0027,\n    blog: \u0027Write a comprehensive blog post outline with introduction, main points, and conclusion. Include SEO keywords and internal linking opportunities.\u0027\n  };\n\n  return basePrompt + platformInstructions[platform] + \u0027\\n\\nGenerate only the content, no explanations or meta-commentary.\u0027;\n}\n\nconst prompt = createContentPrompt(contentData, currentPlatform, spec, contentData.strategy);\n\nreturn {\n  platform: currentPlatform,\n  prompt,\n  spec,\n  contentData,\n  aiModel: \u0027gpt-4o-mini\u0027 // Use cost-effective model for content generation\n};"
                                     },
