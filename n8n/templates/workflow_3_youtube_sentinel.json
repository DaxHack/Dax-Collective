                      "id":  "fetch-recent-videos",
                      "name":  "Fetch Recent Videos",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.1,
                      "position":  [
                                       900,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// Process YouTube API response and check for new videos\nconst response = $input.first();\nconst channelData = $(\u0027Process Each Channel\u0027).first();\n\nif (!response.items || response.items.length === 0) {\n  return [];\n}\n\n// Get last processed video from static data\nconst staticData = $workflow.staticData || {};\nconst lastProcessedKey = `${channelData.brand}_last_video_id`;\nconst lastProcessedVideoId = staticData[lastProcessedKey];\n\nconst newVideos = [];\nlet latestVideoId = null;\n\nfor (const video of response.items) {\n  const videoId = video.id.videoId;\n  \n  // Track the latest video ID\n  if (!latestVideoId) {\n    latestVideoId = videoId;\n  }\n  \n  // If this is the last processed video, stop here\n  if (videoId === lastProcessedVideoId) {\n    break;\n  }\n  \n  // This is a new video\n  newVideos.push({\n    videoId,\n    title: video.snippet.title,\n    description: video.snippet.description,\n    publishedAt: video.snippet.publishedAt,\n    thumbnailUrl: video.snippet.thumbnails.high?.url || video.snippet.thumbnails.default.url,\n    channelId: channelData.channelId,\n    channelName: channelData.channelName,\n    brand: channelData.brand,\n    videoUrl: `https://www.youtube.com/watch?v=${videoId}`\n  });\n}\n\n// Update static data with latest video ID\nif (latestVideoId) {\n  staticData[lastProcessedKey] = latestVideoId;\n}\n\nreturn newVideos;"
                                     },
