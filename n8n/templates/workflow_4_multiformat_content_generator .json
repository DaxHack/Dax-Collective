{
    "name":  "Multiformat Content Generator",
    "nodes":  [
                  {
                      "parameters":  {

                                     },
                      "id":  "content-webhook-trigger",
                      "name":  "Content Generation Webhook",
                      "type":  "n8n-nodes-base.webhook",
                      "typeVersion":  1,
