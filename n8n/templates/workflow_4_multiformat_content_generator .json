                                         "sendBody":  true,
                                         "specifyBody":  "json",
                                         "jsonBody":  "{\n  \"model\": \"{{ $json.aiModel }}\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an expert content creator specializing in {{ $json.contentData.brand }} brand content. Create engaging, platform-optimized content that drives engagement and conversions.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"{{ $json.prompt }}\"\n    }\n  ],\n  \"max_tokens\": 1000,\n  \"temperature\": 0.7\n}",
                                         "options":  {

