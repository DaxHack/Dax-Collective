                  {
                      "parameters":  {
                                         "jsCode":  "// Analyze platform performance and generate optimization recommendations\nconst platformConfig = $(\u0027Configure Platform API\u0027).first();\nconst productsData = $(\u0027Fetch Products\u0027).first();\nconst ordersData = $(\u0027Fetch Recent Orders\u0027).first();\n\n// Process platform-specific data\nfunction processShopifyData(products, orders) {\n  const productList = products.products || [];\n  const orderList = orders.orders || [];\n  \n  const totalRevenue = orderList.reduce((sum, order) =\u003e sum + parseFloat(order.total_price || 0), 0);\n  const totalOrders = orderList.length;\n  const averageOrderValue = totalOrders \u003e 0 ? totalRevenue / totalOrders : 0;\n  \n  // Analyze product performance\n  const productPerformance = productList.map(product =\u003e {\n    const productOrders = orderList.filter(order =\u003e \n      order.line_items?.some(item =\u003e item.product_id === product.id)\n    );\n    const productRevenue = productOrders.reduce((sum, order) =\u003e \n      sum + order.line_items\n        .filter(item =\u003e item.product_id === product.id)\n        .reduce((itemSum, item) =\u003e itemSum + parseFloat(item.price || 0), 0), 0\n    );\n    \n    return {\n      id: product.id,\n      title: product.title,\n      revenue: productRevenue,\n      orders: productOrders.length,\n      inventory: product.variants?.reduce((sum, variant) =\u003e sum + (variant.inventory_quantity || 0), 0) || 0\n    };\n  });\n  \n  return {\n    totalProducts: productList.length,\n    totalRevenue,\n    totalOrders,\n    averageOrderValue,\n    topProducts: productPerformance.sort((a, b) =\u003e b.revenue - a.revenue).slice(0, 5),\n    lowStockProducts: productPerformance.filter(p =\u003e p.inventory \u003c 10)\n  };\n}\n\nfunction processPrintifyData(products, orders) {\n  const productList = products.data || [];\n  const orderList = orders.data || [];\n  \n  const totalRevenue = orderList.reduce((sum, order) =\u003e sum + parseFloat(order.total_price || 0), 0);\n  const totalOrders = orderList.length;\n  \n  return {\n    totalProducts: productList.length,\n    totalRevenue,\n    totalOrders,\n    averageOrderValue: totalOrders \u003e 0 ? totalRevenue / totalOrders : 0,\n    printOnDemandStatus: \u0027active\u0027\n  };\n}\n\nfunction processEtsyData(products, orders) {\n  const productList = products.results || [];\n  const orderList = orders.results || [];\n  \n  const totalRevenue = orderList.reduce((sum, order) =\u003e sum + parseFloat(order.grandtotal || 0), 0);\n  const totalOrders = orderList.length;\n  \n  return {\n    totalProducts: productList.length,\n    totalRevenue,\n    totalOrders,\n    averageOrderValue: totalOrders \u003e 0 ? totalRevenue / totalOrders : 0,\n    handmadeStatus: \u0027active\u0027\n  };\n}\n\n// Process data based on platform\nlet platformAnalysis;\nswitch (platformConfig.platform) {\n  case \u0027shopify\u0027:\n    platformAnalysis = processShopifyData(productsData, ordersData);\n    break;\n  case \u0027printify\u0027:\n    platformAnalysis = processPrintifyData(productsData, ordersData);\n    break;\n  case \u0027etsy\u0027:\n    platformAnalysis = processEtsyData(productsData, ordersData);\n    break;\n  default:\n    platformAnalysis = { error: \u0027Unknown platform\u0027 };\n}\n\n// Generate optimization recommendations\nfunction generateEcommerceOptimizations(platform, analysis, brandStrategies) {\n  const recommendations = [];\n  \n  // Revenue optimization\n  if (analysis.averageOrderValue \u003c 30) {\n    recommendations.push({\n      type: \u0027increase_aov\u0027,\n      priority: \u0027high\u0027,\n      description: \u0027Implement product bundles and upselling to increase average order value\u0027,\n      potential_impact: analysis.totalRevenue * 0.25,\n      action: \u0027Create product bundles and cross-sell recommendations\u0027\n    });\n  }\n  \n  // Inventory management\n  if (analysis.lowStockProducts \u0026\u0026 analysis.lowStockProducts.length \u003e 0) {\n    recommendations.push({\n      type: \u0027inventory_management\u0027,\n      priority: \u0027medium\u0027,\n      description: `${analysis.lowStockProducts.length} products are low in stock`,\n      potential_impact: analysis.totalRevenue * 0.10,\n      action: \u0027Restock low inventory items and implement automated reorder points\u0027\n    });\n  }\n  \n  // Product performance optimization\n  if (analysis.topProducts \u0026\u0026 analysis.topProducts.length \u003e 0) {\n    const topProduct = analysis.topProducts[0];\n    recommendations.push({\n      type: \u0027product_optimization\u0027,\n      priority: \u0027medium\u0027,\n      description: `Optimize top-performing product: ${topProduct.title}`,\n      potential_impact: topProduct.revenue * 0.15,\n      action: \u0027Create variations and expand marketing for top-performing products\u0027\n    });\n  }\n  \n  // Platform-specific optimizations\n  if (platform === \u0027shopify\u0027 \u0026\u0026 analysis.totalProducts \u003c 20) {\n    recommendations.push({\n      type: \u0027product_expansion\u0027,\n      priority: \u0027high\u0027,\n      description: \u0027Expand product catalog to increase sales opportunities\u0027,\n      potential_impact: analysis.totalRevenue * 0.40,\n      action: \u0027Add 10-15 new products based on trending themes and customer demand\u0027\n    });\n  }\n  \n  return recommendations;\n}\n\nconst optimizations = generateEcommerceOptimizations(\n  platformConfig.platform,\n  platformAnalysis,\n  platformConfig.brandStrategies\n);\n\n// Calculate performance score\nconst performanceScore = Math.min(100, (\n  (platformAnalysis.totalRevenue / 1000) * 20 + // Revenue component\n  (platformAnalysis.averageOrderValue / 50) * 30 + // AOV component\n  (platformAnalysis.totalOrders / 10) * 25 + // Order volume component\n  (platformAnalysis.totalProducts / 20) * 25 // Product diversity component\n));\n\nreturn {\n  platform: platformConfig.platform,\n  analysis: platformAnalysis,\n  optimizations,\n  performanceScore,\n  analysisTimestamp: platformConfig.analysisTimestamp,\n  nextActions: optimizations.filter(opt =\u003e opt.priority === \u0027high\u0027).slice(0, 3)\n};"
                                     },
