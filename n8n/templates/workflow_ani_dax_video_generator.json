                      "parameters":  {
                                         "model":  "dall-e-3",
                                         "prompt":  "Anime thumbnail for {{$(\u0027Read Ani-Dax Sheet\u0027).item.json[\u0027Video Title\u0027]}} - {{$(\u0027Read Ani-Dax Sheet\u0027).item.json[\u0027Thumbnail Prompt\u0027]}} - high quality, vibrant colors, YouTube thumbnail style",
                                         "options":  {
                                                         "size":  "1024x1024",
                                                         "quality":  "hd"
                                                     }
                                     },
                      "id":  "7",
                      "name":  "Generate Thumbnail",
