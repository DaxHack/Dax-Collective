                                         "messages":  {
                                                          "values":  [
                                                                         {
                                                                             "role":  "system",
                                                                             "content":  "You are an expert anime content creator specializing in Re:Zero and viral anime content. Create engaging, accurate scripts that hook viewers immediately and maintain engagement throughout."
                                                                         },
                                                                         {
                                                                             "role":  "user",
                                                                             "content":  "Create a detailed video script based on this prompt: {{$json[\u0027Script Prompt\u0027]}}\n\nTarget platform: {{$json[\u0027Target Platform\u0027]}}\nContent type: {{$json[\u0027Content Type\u0027]}}\nTarget length: {{$json[\u0027Output Type\u0027]}}\n\nMake it engaging, accurate to anime lore, and include natural CTAs for Patreon and affiliate links. Start with a strong hook in the first 3 seconds."
                                                                         }
                                                                     ]
                                                      }
                                     },
