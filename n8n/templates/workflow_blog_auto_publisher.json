            }
          ]
        }
      },
      "id": "12",
      "name": "Tweet Faith Blog",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1560,
        400
      ],
      "credentials": {
        "twitterOAuth2Api": {
          "id": "9",
          "name": "Twitter API"
        }
      }
    },
    {
      "parameters": {
        "channel": "={{$env.DISCORD_CHANNEL_ID}}",
        "text": "📝 **BLOG WORKFLOW OUTPUT NEEDS VERIFICATION**\n\n**Travel Blog:** {{$('Publish Travel Blog').item.json.title || 'No travel content'}}\n**Faith Blog:** {{$('Publish Faith Blog').item.json.title || 'No faith content'}}\n\n**Returned URLs:**\n🌍 Travel: {{$('Publish Travel Blog').item.json.URL || 'No verified URL returned'}}\n✝️ Faith: {{$('Publish Faith Blog').item.json.URL || 'No verified URL returned'}}\n\n**Required before marking live:**\n- Confirm publish target and public URL\n- Confirm Daniel approval and brand/account mapping\n- Add monetization links only after approval\n- Record analytics only after real traffic data exists\n\nThis workflow output is not proof of public publication by itself."
      },
      "id": "13",
      "name": "Blog Success Notification",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1780,
        300
      ],
      "credentials": {
        "discordApi": {
          "id": "5",
          "name": "Discord Bot"
        }
      }
    },
    {
      "parameters": {
        "command": "rm /tmp/travel_blog_*.md /tmp/devotional_*.md 2>/dev/null || true"
      },
      "id": "14",
      "name": "Clean Up Processed Files",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        2000,
        300
      ]
    },
    {
      "parameters": {
        "model": "deepseek-chat",
        "options": {
          "temperature": 0.7,
          "maxTokens": 300
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a content performance analyst. Predict blog performance and suggest optimization strategies."
            },
            {
              "role": "user",
              "content": "Analyze these blog workflow outputs for review readiness:\n\nTravel: {{$('Publish Travel Blog').item.json.title || 'None'}}\nFaith: {{$('Publish Faith Blog').item.json.title || 'None'}}\n\nAssess:\n1. Source/claim review needs\n2. Engagement quality\n3. Monetization approval needs\n4. SEO improvement opportunities\n5. Social sharing fit\n\nSuggest conservative optimization actions. Do not predict revenue or treat workflow output as proof of public publication."
            }
          ]
        }
      },
      "id": "15",
      "name": "Analyze Blog Performance Potential",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.3,
      "position": [
        2000,
        480
      ],
      "credentials": {
        "openAiApi": {
          "id": "2",
          "name": "DeepSeek API"
        }
      }
    }
