# =============================================================================
# dax-backend — BACKEND ENVIRONMENT TEMPLATE
# =============================================================================
# Copy this file to .env and fill in real values for local development.
# NEVER commit your real .env file. Never commit real credentials.
#
# These variables are server-side only and MUST NOT be prefixed REACT_APP_.
# Secrets here stay on the server — they are never sent to the browser.
# =============================================================================


# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
SESSION_SECRET=change-this-to-a-long-random-string


# ─── FIREBASE ADMIN (server-side only) ────────────────────────────────────────
# Option A: path to downloaded service account JSON (local dev).
# Option B: base64-encoded JSON string (Replit Secrets / CI). Use one, not both.
#
# To generate a new service account key:
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# Store the downloaded JSON at the path below. Never commit the file.
FIREBASE_SERVICE_ACCOUNT_PATH=./credentials/firebase-adminsdk.json
# FIREBASE_SERVICE_ACCOUNT_JSON=<base64-of-service-account-json>   ← Replit/CI option

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
FIREBASE_DATABASE_URL=https://your-firebase-project-id-default-rtdb.firebaseio.com


# ─── GOOGLE API KEYS (server-side, unrestricted or IP-restricted) ─────────────
# Use separate keys from the browser-restricted keys in dax-main/.env.
# Restrict these by IP or server identity in Google Cloud Console.
GOOGLE_API_KEY=your-backend-google-api-key
GOOGLE_SHEETS_API_KEY=your-backend-google-sheets-api-key
BACKEND_GOOGLE_API_KEY=your-backend-google-api-key
GOOGLE_MAPS_KEY=your-backend-google-maps-api-key
GOOGLE_GEMINI_API_KEY=your-google-gemini-api-key
GOOGLE_TTS_API_KEY=your-google-tts-api-key
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id


# ─── GOOGLE OAUTH (general — Drive, Sheets writes, etc.) ──────────────────────
# OAuth2 credentials from Google Cloud Console → Credentials → OAuth 2.0 Client.
# client_secret and refresh_token are secrets — server-side only.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
GOOGLE_REFRESH_TOKEN=your-google-refresh-token


# ─── GOOGLE PHOTOS OAUTH (separate OAuth client recommended) ─────────────────
# Google Photos requires OAuth — service accounts are NOT supported.
GOOGLE_PHOTOS_CLIENT_ID=your-photos-oauth-client-id.apps.googleusercontent.com
GOOGLE_PHOTOS_CLIENT_SECRET=your-photos-oauth-client-secret
GOOGLE_PHOTOS_REDIRECT_URI=http://localhost:5000/auth/photos/callback
GOOGLE_PHOTOS_REFRESH_TOKEN=your-photos-refresh-token


# ─── GOOGLE ANALYTICS (server-side reporting) ─────────────────────────────────
GOOGLE_ANALYTICS_PROPERTY_ID=your-ga4-property-id
GOOGLE_ANALYTICS_ACCOUNT_ID=your-ga-account-id
GOOGLE_ANALYTICS_STREAM_ID=your-ga-stream-id
GOOGLE_ANALYTICS_API_SECRET=your-ga-api-secret


# ─── GOOGLE DRIVE FOLDER IDs (backend routing) ────────────────────────────────
# Backend uses its own copies of folder IDs — do not share REACT_APP_ names here.
DRIVE_FOLDER_TRAVEL=your-drive-travel-folder-id
DRIVE_FOLDER_FAITH=your-drive-faith-folder-id
DRIVE_FOLDER_COLLECTIVE=your-drive-collective-folder-id
DRIVE_FOLDER_TIMEZONE=your-drive-timezone-folder-id


# ─── YOUTUBE ──────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=your-backend-youtube-api-key
YOUTUBE_CLIENT_ID=your-youtube-oauth-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-youtube-oauth-client-secret


# ─── n8n AUTOMATION ───────────────────────────────────────────────────────────
N8N_API_KEY=your-n8n-api-key
N8N_WEBHOOK_URL=http://localhost:5678
N8N_BASE_URL=http://localhost:5678


# ─── AI PROVIDERS ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
CLAUDE_API_KEY=your-anthropic-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Model names (optional — defaults handled in code)
MODEL_MIXTRAL=mistralai/mixtral-8x7b-instruct
MODEL_GEMINI=google/gemini-pro
MODEL_CLAUDE=anthropic/claude-3-haiku
MODEL_COMMANDR=cohere/command-r
MODEL_DEEPSEEK=deepseek/deepseek-chat
MODEL_OPENCHAT=openchat/openchat-7b
OPENROUTER_MODEL=mistralai/mixtral-8x7b-instruct


# ─── SOCIAL MEDIA (secrets and access tokens — server-side only) ──────────────

# TikTok
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_ACCOUNT_ID_ANIDAX=your-anidax-tiktok-account-id
TIKTOK_ACCOUNT_ID_DAX_TRAVELER=your-dax-traveler-tiktok-account-id
TIKTOK_ACCOUNT_ID_GODS_VESSEL=your-gods-vessel-tiktok-account-id
TIKTOK_ACCOUNT_ID_TIMEZONE_TRAVELERS=your-timezone-travelers-tiktok-account-id

# Facebook / Meta
FACEBOOK_ACCESS_TOKEN=your-facebook-page-access-token
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_PAGE_ID_ANIDAX=your-anidax-page-id
FACEBOOK_PAGE_ID_DAX_TRAVELER=your-dax-traveler-page-id
FACEBOOK_PAGE_ID_GODS_VESSEL=your-gods-vessel-page-id
FACEBOOK_PAGE_ID_TIMEZONE_TRAVELERS=your-timezone-travelers-page-id

# Instagram
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
INSTAGRAM_ACCOUNT_ID_ANIDAX=your-anidax-instagram-account-id
INSTAGRAM_ACCOUNT_ID_DAX_TRAVELER=your-dax-traveler-instagram-account-id
INSTAGRAM_ACCOUNT_ID_GODS_VESSEL=your-gods-vessel-instagram-account-id
INSTAGRAM_ACCOUNT_ID_TIMEZONE_TRAVELERS=your-timezone-travelers-instagram-account-id

# Twitter / X
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret
TWITTER_BEARER_TOKEN=your-twitter-bearer-token


# ─── FEATURE TOGGLES & SCHEDULES ─────────────────────────────────────────────
BRAND_ANIDAX_ENABLED=true
BRAND_DAX_TRAVELER_ENABLED=true
BRAND_GODS_VESSEL_ENABLED=true
BRAND_TIMEZONE_TRAVELERS_ENABLED=true
AUTO_POSTING_ENABLED=false
CONTENT_GENERATION_ENABLED=true

SCHEDULE_ANIDAX_POSTING=0 9,15,21 * * *
SCHEDULE_DAX_TRAVELER_POSTING=0 8,14,20 * * *
SCHEDULE_GODS_VESSEL_POSTING=0 7,12,19 * * *
SCHEDULE_TIMEZONE_TRAVELERS_POSTING=0 10,16,22 * * *

MAX_POSTS_PER_DAY_ANIDAX=5
MAX_POSTS_PER_DAY_DAX_TRAVELER=4
MAX_POSTS_PER_DAY_GODS_VESSEL=3
MAX_POSTS_PER_DAY_TIMEZONE_TRAVELERS=4
