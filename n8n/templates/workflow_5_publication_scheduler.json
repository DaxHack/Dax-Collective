                  {
                      "parameters":  {
                                         "jsCode":  "// Publication Scheduler \u0026 Optimizer\n// Analyzes content queue and schedules optimal publishing times\n\nconst contentQueue = $input.all();\nconst now = new Date();\n\n// Brand-specific posting schedules and limits\nconst brandSchedules = {\n  dax_traveler: {\n    platforms: {\n      instagram: { times: [\u002708:00\u0027, \u002712:00\u0027, \u002718:00\u0027], dailyLimit: 2, timezone: \u0027UTC\u0027 },\n      facebook: { times: [\u002709:00\u0027, \u002715:00\u0027, \u002720:00\u0027], dailyLimit: 2, timezone: \u0027UTC\u0027 },\n      twitter: { times: [\u002707:00\u0027, \u002711:00\u0027, \u002715:00\u0027, \u002719:00\u0027], dailyLimit: 4, timezone: \u0027UTC\u0027 },\n      linkedin: { times: [\u002708:00\u0027, \u002717:00\u0027], dailyLimit: 1, timezone: \u0027UTC\u0027 },\n      tiktok: { times: [\u002712:00\u0027, \u002718:00\u0027, \u002721:00\u0027], dailyLimit: 2, timezone: \u0027UTC\u0027 }\n    },\n    enabled: $env.BRAND_DAX_TRAVELER_ENABLED === \u0027true\u0027\n  },\n  timezone_travelers: {\n    platforms: {\n      instagram: { times: [\u002710:00\u0027, \u002714:00\u0027, \u002719:00\u0027], dailyLimit: 2, timezone: \u0027UTC\u0027 },\n      facebook: { times: [\u002711:00\u0027, \u002716:00\u0027], dailyLimit: 1, timezone: \u0027UTC\u0027 },\n      twitter: { times: [\u002708:00\u0027, \u002712:00\u0027, \u002716:00\u0027, \u002720:00\u0027], dailyLimit: 3, timezone: \u0027UTC\u0027 },\n      pinterest: { times: [\u002709:00\u0027, \u002713:00\u0027, \u002717:00\u0027], dailyLimit: 3, timezone: \u0027UTC\u0027 }\n    },\n    enabled: $env.BRAND_TIMEZONE_TRAVELERS_ENABLED === \u0027true\u0027\n  },\n  gods_vessel: {\n    platforms: {\n      instagram: { times: [\u002706:00\u0027, \u002712:00\u0027, \u002718:00\u0027], dailyLimit: 2, timezone: \u0027UTC\u0027 },\n      facebook: { times: [\u002707:00\u0027, \u002719:00\u0027], dailyLimit: 2, timezone: \u0027UTC\u0027 },\n      twitter: { times: [\u002706:00\u0027, \u002712:00\u0027, \u002718:00\u0027], dailyLimit: 3, timezone: \u0027UTC\u0027 },\n      pinterest: { times: [\u002708:00\u0027, \u002714:00\u0027, \u002720:00\u0027], dailyLimit: 2, timezone: \u0027UTC\u0027 }\n    },\n    enabled: $env.BRAND_GODS_VESSEL_ENABLED === \u0027true\u0027\n  },\n  ani_dax: {\n    platforms: {\n      instagram: { times: [\u002714:00\u0027, \u002720:00\u0027, \u002722:00\u0027], dailyLimit: 2, timezone: \u0027UTC\u0027 },\n      facebook: { times: [\u002715:00\u0027, \u002721:00\u0027], dailyLimit: 1, timezone: \u0027UTC\u0027 },\n      twitter: { times: [\u002713:00\u0027, \u002717:00\u0027, \u002721:00\u0027], dailyLimit: 3, timezone: \u0027UTC\u0027 },\n      tiktok: { times: [\u002716:00\u0027, \u002720:00\u0027, \u002723:00\u0027], dailyLimit: 2, timezone: \u0027UTC\u0027 },\n      reddit: { times: [\u002719:00\u0027, \u002722:00\u0027], dailyLimit: 1, timezone: \u0027UTC\u0027 }\n    },\n    enabled: $env.BRAND_ANI_DAX_ENABLED === \u0027true\u0027\n  }\n};\n\n// Filter content ready for publishing\nconst readyContent = contentQueue.filter(item =\u003e \n  item.ready_for_publishing === true \u0026\u0026 \n  item.status === \u0027generated\u0027 \u0026\u0026 \n  !item.scheduled_time\n);\n\nif (readyContent.length === 0) {\n  return { message: \u0027No content ready for scheduling\u0027, scheduledCount: 0 };\n}\n\n// Get today\u0027s already scheduled posts to respect daily limits\nconst today = now.toISOString().split(\u0027T\u0027)[0];\nconst todayScheduled = contentQueue.filter(item =\u003e \n  item.scheduled_time \u0026\u0026 \n  item.scheduled_time.startsWith(today)\n);\n\n// Count scheduled posts by brand and platform for today\nconst todayCounts = {};\ntodayScheduled.forEach(item =\u003e {\n  const key = `${item.brand}_${item.platform}`;\n  todayCounts[key] = (todayCounts[key] || 0) + 1;\n});\n\n// Schedule content based on optimal times and limits\nconst scheduledContent = [];\n\nreadyContent.forEach(content =\u003e {\n  const brand = content.brand;\n  const platform = content.platform;\n  \n  if (!brandSchedules[brand] || !brandSchedules[brand].enabled) {\n    return;\n  }\n  \n  const platformConfig = brandSchedules[brand].platforms[platform];\n  if (!platformConfig) {\n    return;\n  }\n  \n  const countKey = `${brand}_${platform}`;\n  const currentCount = todayCounts[countKey] || 0;\n  \n  if (currentCount \u003e= platformConfig.dailyLimit) {\n    return; // Daily limit reached\n  }\n  \n  // Find next available time slot\n  const availableTimes = platformConfig.times;\n  let scheduledTime = null;\n  \n  for (const timeSlot of availableTimes) {\n    const [hours, minutes] = timeSlot.split(\u0027:\u0027).map(Number);\n    const candidateTime = new Date(now);\n    candidateTime.setHours(hours, minutes, 0, 0);\n    \n    // If time has passed today, schedule for tomorrow\n    if (candidateTime \u003c= now) {\n      candidateTime.setDate(candidateTime.getDate() + 1);\n    }\n    \n    // Check if this time slot is already taken\n    const timeString = candidateTime.toISOString();\n    const isSlotTaken = scheduledContent.some(item =\u003e \n      item.scheduled_time === timeString \u0026\u0026 \n      item.brand === brand \u0026\u0026 \n      item.platform === platform\n    );\n    \n    if (!isSlotTaken) {\n      scheduledTime = timeString;\n      break;\n    }\n  }\n  \n  if (scheduledTime) {\n    scheduledContent.push({\n      ...content,\n      scheduled_time: scheduledTime,\n      status: \u0027scheduled\u0027\n    });\n    \n    // Update count for this brand/platform\n    todayCounts[countKey] = currentCount + 1;\n  }\n});\n\nreturn {\n  scheduledContent,\n  scheduledCount: scheduledContent.length,\n  totalReady: readyContent.length,\n  timestamp: now.toISOString()\n};"
                                     },
