                      "parameters":  {
                                         "command":  "ffmpeg -loop 1 -i {{$json.data[0].url}} -i {{$(\u0027Generate Voice with ElevenLabs\u0027).item.binary.data}} -c:v libx264 -tune stillimage -c:a aac -b:a 192k -pix_fmt yuv420p -shortest /tmp/ani_dax_{{$(\u0027Read Ani-Dax Sheet\u0027).item.json[\u0027Video Title\u0027].replace(/[^a-zA-Z0-9]/g, \u0027_\u0027)}}.mp4"
                                     },
