# dax-backend/.env.example
# Backend Node.js API server environment variables (SAFE TEMPLATE)
# Set real values via Replit Secrets ONLY. Never commit secrets.

# =============================================================================
# SERVER
# =============================================================================
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5000
BACKEND_URL=http://localhost:3001

# =============================================================================
# FIREBASE ADMIN (server-side)
# =============================================================================
FIREBASE_SERVICE_ACCOUNT_PATH=./credentials/firebase-adminsdk.json
FIREBASE_PROJECT_ID=dax-collective
FIREBASE_STORAGE_BUCKET=dax-collective.appspot.com
FIREBASE_DATABASE_URL=

# =============================================================================
# GOOGLE API KEYS (backend-only, unrestricted or IP-restricted)
# These are used for server-side proxy calls (Sheets, Drive, YouTube).
# =============================================================================
GOOGLE_API_KEY=YOUR_BACKEND_GOOGLE_API_KEY
GOOGLE_SHEETS_API_KEY=YOUR_BACKEND_GOOGLE_SHEETS_KEY
GOOGLE_DRIVE_API_KEY=YOUR_BACKEND_GOOGLE_DRIVE_KEY
GOOGLE_MAPS_KEY=YOUR_BACKEND_GOOGLE_MAPS_KEY
BACKEND_GOOGLE_API_KEY=YOUR_BACKEND_GOOGLE_API_KEY

# =============================================================================
# GOOGLE OAUTH (for Google Drive / Photos)
# =============================================================================
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:5678/rest/oauth2-credential/callback
GOOGLE_REFRESH_TOKEN=YOUR_GOOGLE_REFRESH_TOKEN

# =============================================================================
# GOOGLE ANALYTICS
# =============================================================================
GOOGLE_ANALYTICS_ACCOUNT_ID=
GOOGLE_ANALYTICS_STREAM_ID=
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_ANALYTICS_API_SECRET=

# =============================================================================
# GOOGLE SHEET IDs (backend reads SHEET_* or REACT_APP_SHEET_*)
# These are public document IDs — not secrets.
# =============================================================================
SHEET_GODS_VESSEL_QUOTES=YOUR_GODS_VESSEL_SHEET_ID
SHEET_DAX_TRAVELER_BLOGS=YOUR_DAX_TRAVELER_SHEET_ID
SHEET_TIMEZONE_TRAVELERS_BLOGS_ITINERARIES=YOUR_TZ_TRAVELERS_SHEET_ID
SHEET_GODS_VESSEL_DISCUSSIONS=YOUR_GODS_VESSEL_DISCUSSIONS_SHEET_ID
SHEET_TSHIRT_DESIGNS_CANVA_BULK=YOUR_TSHIRT_DESIGNS_SHEET_ID
SHEET_SATIATED_TASTE_RECIPES=YOUR_RECIPES_SHEET_ID
SHEET_BRAND_ANALYTICS_DASHBOARD=YOUR_ANALYTICS_SHEET_ID
SHEET_SOCIAL_TRACKING_YOUTUBE=YOUR_SOCIAL_TRACKING_YOUTUBE_SHEET_ID
SHEET_SOCIAL_TRACKING_INSTAGRAM=YOUR_SOCIAL_TRACKING_INSTAGRAM_SHEET_ID
SHEET_SOCIAL_TRACKING_TIKTOK=YOUR_SOCIAL_TRACKING_TIKTOK_SHEET_ID
SHEET_SOCIAL_TRACKING_TWITTER=YOUR_SOCIAL_TRACKING_TWITTER_SHEET_ID
SHEET_SOCIAL_TRACKING_FACEBOOK=YOUR_SOCIAL_TRACKING_FACEBOOK_SHEET_ID

# =============================================================================
# GOOGLE DRIVE FOLDER IDs (backend routing)
# =============================================================================
DRIVE_FOLDER_TRAVEL=YOUR_DRIVE_FOLDER_ID
DRIVE_FOLDER_FAITH=YOUR_DRIVE_FOLDER_ID
DRIVE_FOLDER_COLLECTIVE=YOUR_DRIVE_FOLDER_ID
DRIVE_FOLDER_TIMEZONE=YOUR_DRIVE_FOLDER_ID

# =============================================================================
# YOUTUBE API
# =============================================================================
YOUTUBE_API_KEY=YOUR_BACKEND_YOUTUBE_API_KEY
YOUTUBE_CLIENT_ID=YOUR_YOUTUBE_CLIENT_ID
YOUTUBE_CLIENT_SECRET=YOUR_YOUTUBE_CLIENT_SECRET

# =============================================================================
# SOCIAL POSTING APIs
# =============================================================================
TIKTOK_ACCESS_TOKEN=YOUR_TIKTOK_TOKEN
TIKTOK_ACCOUNT_ID_ANIDAX=YOUR_TIKTOK_ACCOUNT_ID
TIKTOK_ACCOUNT_ID_DAX_TRAVELER=YOUR_TIKTOK_ACCOUNT_ID
TIKTOK_ACCOUNT_ID_GODS_VESSEL=YOUR_TIKTOK_ACCOUNT_ID
TIKTOK_ACCOUNT_ID_TIMEZONE_TRAVELERS=YOUR_TIKTOK_ACCOUNT_ID

FACEBOOK_ACCESS_TOKEN=YOUR_FB_TOKEN
FACEBOOK_APP_ID=YOUR_FB_APP_ID
FACEBOOK_APP_SECRET=YOUR_FB_APP_SECRET
FACEBOOK_PAGE_ID_ANIDAX=YOUR_FB_PAGE_ID
FACEBOOK_PAGE_ID_DAX_TRAVELER=YOUR_FB_PAGE_ID
FACEBOOK_PAGE_ID_GODS_VESSEL=YOUR_FB_PAGE_ID
FACEBOOK_PAGE_ID_TIMEZONE_TRAVELERS=YOUR_FB_PAGE_ID

INSTAGRAM_ACCESS_TOKEN=YOUR_IG_TOKEN
INSTAGRAM_APP_ID=YOUR_IG_APP_ID
INSTAGRAM_APP_SECRET=YOUR_IG_APP_SECRET
INSTAGRAM_ACCOUNT_ID_ANIDAX=YOUR_IG_ACCOUNT_ID
INSTAGRAM_ACCOUNT_ID_DAX_TRAVELER=YOUR_IG_ACCOUNT_ID
INSTAGRAM_ACCOUNT_ID_GODS_VESSEL=YOUR_IG_ACCOUNT_ID
INSTAGRAM_ACCOUNT_ID_TIMEZONE_TRAVELERS=YOUR_IG_ACCOUNT_ID

# =============================================================================
# AI / LLM / TTS
# =============================================================================
OPENAI_API_KEY=YOUR_OPENAI_KEY
CLAUDE_API_KEY=YOUR_CLAUDE_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY
OPENROUTER_MODEL=
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_KEY
MODEL_MIXTRAL=
MODEL_GEMINI=
MODEL_CLAUDE=
MODEL_COMMANDR=
MODEL_DEEPSEEK=
MODEL_OPENCHAT=

# =============================================================================
# N8N AUTOMATION
# =============================================================================
N8N_WEBHOOK_URL=http://localhost:5678
N8N_API_KEY=YOUR_N8N_API_KEY

# =============================================================================
# FEATURE TOGGLES & SCHEDULES
# =============================================================================
BRAND_ANIDAX_ENABLED=true
BRAND_DAX_TRAVELER_ENABLED=true
BRAND_GODS_VESSEL_ENABLED=true
BRAND_TIMEZONE_TRAVELERS_ENABLED=true
AUTO_POSTING_ENABLED=false
SCHEDULE_ANIDAX_POSTING=
MAX_POSTS_PER_DAY_ANIDAX=5
