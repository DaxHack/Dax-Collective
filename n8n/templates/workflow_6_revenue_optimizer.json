                      "id":  "revenue-analysis-trigger",
                      "name":  "Analyze Revenue Every 6 Hours",
                      "type":  "n8n-nodes-base.scheduleTrigger",
                      "typeVersion":  1.1,
                      "position":  [
                                       240,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// Revenue Optimization Agent\n// Analyzes revenue streams and optimizes pricing, affiliate links, and monetization strategies\n\nconst revenueSources = {\n  patreon: {\n    enabled: $env.PATREON_ENABLED === \u0027true\u0027,\n    apiKey: $env.PATREON_API_KEY,\n    campaignId: $env.PATREON_CAMPAIGN_ID\n  },\n  shopify: {\n    enabled: $env.SHOPIFY_ENABLED === \u0027true\u0027,\n    apiKey: $env.SHOPIFY_API_KEY,\n    shopDomain: $env.SHOPIFY_SHOP_DOMAIN\n  },\n  printify: {\n    enabled: $env.PRINTIFY_ENABLED === \u0027true\u0027,\n    apiKey: $env.PRINTIFY_API_KEY,\n    shopId: $env.PRINTIFY_SHOP_ID\n  },\n  youtube: {\n    enabled: $env.YOUTUBE_MONETIZATION_ENABLED === \u0027true\u0027,\n    apiKey: $env.YOUTUBE_API_KEY,\n    channels: [\n      { id: $env.DAX_TRAVELER_CHANNEL_ID, brand: \u0027dax_traveler\u0027 },\n      { id: $env.GODS_VESSEL_CHANNEL_ID, brand: \u0027gods_vessel\u0027 },\n      { id: $env.TIMEZONE_TRAVELERS_CHANNEL_ID, brand: \u0027timezone_travelers\u0027 },\n      { id: $env.ANI_DAX_CHANNEL_ID, brand: \u0027ani_dax\u0027 }\n    ]\n  },\n  affiliates: {\n    enabled: $env.AFFILIATE_TRACKING_ENABLED === \u0027true\u0027,\n    networks: {\n      amazon: { enabled: true, tag: $env.AMAZON_AFFILIATE_TAG },\n      booking: { enabled: true, id: $env.BOOKING_AFFILIATE_ID },\n      worldnomads: { enabled: true, id: $env.WORLDNOMADS_AFFILIATE_ID }\n    }\n  }\n};\n\n// Revenue optimization targets\nconst revenueTargets = {\n  monthly: {\n    month1: 2000,   // $1-2k\n    month2: 5000,   // $3-5k\n    month3: 10000,  // $7-10k\n    month4: 20000,  // $15-20k\n    month5: 35000,  // $25-35k\n    month6: 50000   // $50k+\n  },\n  breakdown: {\n    patreon: 0.30,      // 30% from subscriptions\n    ecommerce: 0.25,    // 25% from merchandise\n    affiliates: 0.20,   // 20% from affiliate marketing\n    youtube: 0.15,      // 15% from YouTube monetization\n    services: 0.10      // 10% from services/consulting\n  }\n};\n\nconst currentMonth = new Date().getMonth() + 1;\nconst currentTarget = revenueTargets.monthly[`month${Math.min(currentMonth, 6)}`];\n\nreturn {\n  revenueSources,\n  revenueTargets,\n  currentTarget,\n  analysisTimestamp: new Date().toISOString(),\n  enabledSources: Object.keys(revenueSources).filter(source =\u003e revenueSources[source].enabled)\n};"
                                     },
                      "id":  "prepare-revenue-analysis",
                      "name":  "Prepare Revenue Analysis",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       460,
