# ─── ROOT WORKSPACE .gitignore ─────────────────────────────────────────────
# Covers the monorepo root, dax-main (React), dax-backend (Node), and n8n.

# ─── DEPENDENCIES ──────────────────────────────────────────────────────────
**/node_modules/
/.pnp
.pnp.js

# ─── LOCKFILES (only track root, ignore workspace copies) ──────────────────
/dax-main/package-lock.json
/dax-backend/package-lock.json
/functions/package-lock.json
**/yarn.lock
**/pnpm-lock.yaml

# ─── BUILD OUTPUTS ─────────────────────────────────────────────────────────
/dax-main/build/
/frontend/build/
/functions/lib/
/dist/
/.next/
/out/
build/

# ─── ENV & SECRETS ─────────────────────────────────────────────────────────
# Never commit real environment files.
.env
.env.local
.env.development
.env.production
.env.test
.env.*
*.env
!.env.example
!**/.env.example
dax-main/.env
dax-backend/.env
/functions/.env

# ─── CREDENTIALS & SERVICE ACCOUNTS ────────────────────────────────────────
# All credential files must stay off git regardless of location.
credentials/
dax-backend/credentials/
**/credentials/
*firebase-adminsdk*.json
*service-account*.json
*serviceAccountKey*.json
*.pem
*.key
/keys/
**/keys/

# ─── FIREBASE ──────────────────────────────────────────────────────────────
.firebaserc
.firebase/
firebase-debug.log*
firebase-debug.*.log
**/firebase-debug.*.log
.firebase/**/*.cache

# ─── CACHES & COVERAGE ─────────────────────────────────────────────────────
.cache/
.tmp/
.nyc_output/
coverage/
jest-coverage/
.eslintcache

# ─── RUNTIME / DATA FILES ──────────────────────────────────────────────────
/dax-backend/uploads/
*.sqlite
*.sqlite3
*.db
dump.rdb
*.bak
*.pid
*.pid.lock
*.seed

# ─── LOGS & TEMP ───────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
*.tmp
*.swp
*.swo
*~

# ─── IDE & OS ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.DS_Store
Thumbs.db

# ─── DOCKER & COMPOSE ──────────────────────────────────────────────────────
docker-compose.override.yml

# ─── n8n ───────────────────────────────────────────────────────────────────
/.n8n/
.n8n-custom/
/n8n/env/
/n8n/docker/
/n8n/templates/*.sqlite
/n8n/scripts/*.log

# ─── SUMMARY FILES ─────────────────────────────────────────────────────────
/dax-backend-structure-summary.txt
/dax-main-structure-summary.txt
