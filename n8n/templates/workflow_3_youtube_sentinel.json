                                                                                        "value":  "video"
                                                                                    },
                                                                                    {
                                                                                        "name":  "key",
                                                                                        "value":  "={{ $json.apiKey }}"
                                                                                    },
                                                                                    {
                                                                                        "name":  "publishedAfter",
                                                                                        "value":  "={{ new Date(Date.now() - 24 * 60 * 60 * 1000).toISOString() }}"
