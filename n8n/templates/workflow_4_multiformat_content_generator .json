                      "id":  "generate-ai-content",
                      "name":  "Generate AI Content",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.1,
                      "position":  [
                                       1340,
                                       200
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// Process AI response and format content\nconst aiResponse = $input.first();\nconst platformData = $(\u0027Generate Platform Prompt\u0027).first();\n\nif (!aiResponse.choices || !aiResponse.choices[0]) {\n  throw new Error(\u0027Invalid AI response received\u0027);\n}\n\nconst generatedContent = aiResponse.choices[0].message.content.trim();\n\n// Extract hashtags from content\nfunction extractHashtags(content) {\n  const hashtagRegex = /#[a-zA-Z0-9_]+/g;\n  return content.match(hashtagRegex) || [];\n}\n\n// Add affiliate links based on content and brand\nfunction addAffiliateLinks(content, brand, topics) {\n  const affiliateLinks = {\n    dax_traveler: {\n      \u0027travel gear\u0027: \u0027https://amzn.to/travel-gear\u0027,\n      \u0027booking\u0027: \u0027https://booking.com/ref/dax-traveler\u0027,\n      \u0027insurance\u0027: \u0027https://worldnomads.com/ref/dax\u0027\n    },\n    timezone_travelers: {\n      \u0027guides\u0027: \u0027https://amzn.to/travel-guides\u0027,\n      \u0027apps\u0027: \u0027https://apps.com/ref/timezone\u0027,\n      \u0027booking\u0027: \u0027https://booking.com/ref/timezone\u0027\n    },\n    gods_vessel: {\n      \u0027books\u0027: \u0027https://amzn.to/christian-books\u0027,\n      \u0027merchandise\u0027: \u0027https://godsvesselstore.com\u0027,\n      \u0027devotionals\u0027: \u0027https://amzn.to/devotionals\u0027\n    },\n    ani_dax: {\n      \u0027merchandise\u0027: \u0027https://amzn.to/anime-merch\u0027,\n      \u0027manga\u0027: \u0027https://amzn.to/manga-collection\u0027,\n      \u0027streaming\u0027: \u0027https://crunchyroll.com/ref/anidax\u0027\n    }\n  };\n\n  let contentWithLinks = content;\n  const brandLinks = affiliateLinks[brand] || {};\n  \n  // Add relevant affiliate links based on topics\n  Object.keys(brandLinks).forEach(keyword =\u003e {\n    if (topics.some(topic =\u003e topic.toLowerCase().includes(keyword)) || \n        content.toLowerCase().includes(keyword)) {\n      contentWithLinks += `\\n\\nðŸ”— ${brandLinks[keyword]}`;\n    }\n  });\n\n  return contentWithLinks;\n}\n\n// Format final content\nconst hashtags = extractHashtags(generatedContent);\nconst contentWithAffiliates = addAffiliateLinks(\n  generatedContent, \n  platformData.contentData.brand, \n  platformData.contentData.topics\n);\n\n// Create final content object\nconst finalContent = {\n  platform: platformData.platform,\n  content: contentWithAffiliates,\n  hashtags,\n  characterCount: contentWithAffiliates.length,\n  brand: platformData.contentData.brand,\n  videoId: platformData.contentData.videoId,\n  contentId: platformData.contentData.contentId,\n  generatedAt: new Date().toISOString(),\n  status: \u0027generated\u0027,\n  readyForPublishing: contentWithAffiliates.length \u003c= platformData.spec.maxLength\n};\n\nreturn finalContent;"
                                     },
