                      "id":  "fetch-captions",
                      "name":  "Fetch Video Captions",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.1,
                      "position":  [
                                       1780,
                                       200
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// Extract transcript and analyze content\nconst videoData = $(\u0027Process Each Video\u0027).first();\nconst captionsResponse = $input.first();\n\nlet transcript = \u0027\u0027;\nlet hasTranscript = false;\n\n// Check if captions are available\nif (captionsResponse.items \u0026\u0026 captionsResponse.items.length \u003e 0) {\n  // For now, we\u0027ll use the description as content since caption download requires OAuth\n  transcript = videoData.description;\n  hasTranscript = true;\n} else {\n  // Use title and description for content analysis\n  transcript = `${videoData.title}\\n\\n${videoData.description}`;\n}\n\n// Analyze content for key themes and topics\nfunction extractKeywords(text) {\n  const words = text.toLowerCase()\n    .replace(/[^a-z0-9\\s]/g, \u0027 \u0027)\n    .split(/\\s+/)\n    .filter(word =\u003e word.length \u003e 3);\n  \n  const frequency = {};\n  words.forEach(word =\u003e {\n    frequency[word] = (frequency[word] || 0) + 1;\n  });\n  \n  return Object.entries(frequency)\n    .sort(([,a], [,b]) =\u003e b - a)\n    .slice(0, 10)\n    .map(([word]) =\u003e word);\n}\n\nfunction extractTopics(text, brand) {\n  const topics = [];\n  const lowerText = text.toLowerCase();\n  \n  // Brand-specific topic extraction\n  if (brand === \u0027dax_traveler\u0027 || brand === \u0027timezone_travelers\u0027) {\n    const travelKeywords = [\u0027travel\u0027, \u0027destination\u0027, \u0027trip\u0027, \u0027adventure\u0027, \u0027explore\u0027, \u0027journey\u0027, \u0027vacation\u0027, \u0027backpack\u0027, \u0027culture\u0027, \u0027food\u0027];\n    topics.push(...travelKeywords.filter(keyword =\u003e lowerText.includes(keyword)));\n  }\n  \n  if (brand === \u0027gods_vessel\u0027) {\n    const faithKeywords = [\u0027faith\u0027, \u0027god\u0027, \u0027jesus\u0027, \u0027prayer\u0027, \u0027bible\u0027, \u0027christian\u0027, \u0027worship\u0027, \u0027blessing\u0027, \u0027grace\u0027, \u0027love\u0027];\n    topics.push(...faithKeywords.filter(keyword =\u003e lowerText.includes(keyword)));\n  }\n  \n  if (brand === \u0027ani_dax\u0027) {\n    const animeKeywords = [\u0027anime\u0027, \u0027manga\u0027, \u0027otaku\u0027, \u0027cosplay\u0027, \u0027japan\u0027, \u0027character\u0027, \u0027series\u0027, \u0027episode\u0027, \u0027review\u0027, \u0027recommendation\u0027];\n    topics.push(...animeKeywords.filter(keyword =\u003e lowerText.includes(keyword)));\n  }\n  \n  return [...new Set(topics)];\n}\n\nconst keywords = extractKeywords(transcript);\nconst topics = extractTopics(transcript, videoData.brand);\n\n// Create content analysis\nconst contentAnalysis = {\n  ...videoData,\n  transcript,\n  hasTranscript,\n  keywords,\n  topics,\n  contentLength: transcript.length,\n  analysisTimestamp: new Date().toISOString(),\n  readyForContentGeneration: true\n};\n\nreturn contentAnalysis;"
                                     },
