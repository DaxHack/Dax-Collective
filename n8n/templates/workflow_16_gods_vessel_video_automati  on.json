                                                                               "role":  "system",
                                                                               "message":  "You are creating scripture graphics for a faith-based video. Generate clean, readable text overlays for key Bible verses and inspirational quotes."
                                                                           },
                                                                           {
                                                                               "role":  "user",
                                                                               "message":  "Create text overlay graphics for these scripture references and key points:\n\nScripture references: {{ $json.scripture_references }}\nVisual cues: {{ $json.visual_cues }}\n\nFor each, provide:\n1. Main text (scripture or quote)\n2. Reference (book, chapter, verse)\n3. Background color suggestion\n4. Font style recommendation\n5. Positioning guidance\n\nKeep text concise and readable for video overlay. Use encouraging, hope-filled language that complements the devotional message."
                                                                           }
                                                                       ]
                                                      },
                                         "options":  {
                                                         "temperature":  0.5,
                                                         "maxTokens":  1000
                                                     }
