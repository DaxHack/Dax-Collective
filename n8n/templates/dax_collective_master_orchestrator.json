                  {
                      "parameters":  {
                                         "jsCode":  "const brands = $input.all();\nconst currentHour = new Date().getHours();\n\nconst brandSchedules = {\n  \u0027Dax the Traveler\u0027: { hours: [8, 14, 20], priority: 1 },\n  \u0027God\\\u0027s Vessel\u0027: { hours: [7, 12, 19], priority: 2 },\n  \u0027Ani-Dax\u0027: { hours: [9, 15, 21], priority: 3 },\n  \u0027Time-Zone Travelers\u0027: { hours: [10, 16, 22], priority: 4 }\n};\n\nconst activeBrands = [];\n\nfor (const brand of brands) {\n  const brandData = brand.json;\n  const brandName = brandData[\u0027Brand Name\u0027];\n  const schedule = brandSchedules[brandName];\n  \n  if (!schedule) continue;\n  \n  const shouldPost = schedule.hours.includes(currentHour);\n  const isEnabled = brandData[\u0027Automation Status\u0027] === \u0027Ready\u0027;\n  \n  if (shouldPost \u0026\u0026 isEnabled) {\n    activeBrands.push({\n      json: {\n        ...brandData,\n        priority: schedule.priority,\n        shouldTrigger: true,\n        triggerTime: new Date().toISOString()\n      }\n    });\n  }\n}\n\nactiveBrands.sort((a, b) =\u003e a.json.priority - b.json.priority);\n\nreturn activeBrands;"
                                     },
