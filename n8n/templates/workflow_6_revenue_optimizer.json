                      "id":  "fetch-revenue-data",
                      "name":  "Fetch Revenue Data",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.1,
                      "position":  [
                                       1340,
                                       200
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// Process revenue data and calculate metrics\nconst sourceConfig = $(\u0027Configure Source Analysis\u0027).first();\nconst apiResponse = $(\u0027Fetch Revenue Data\u0027).first();\n\nlet currentRevenue = 0;\nlet metrics = {};\n\n// Process data based on source type\nswitch (sourceConfig.source) {\n  case \u0027patreon\u0027:\n    if (apiResponse.data \u0026\u0026 apiResponse.data.attributes) {\n      currentRevenue = apiResponse.data.attributes.pledge_sum / 100; // Convert cents to dollars\n      metrics = {\n        patron_count: apiResponse.data.attributes.patron_count,\n        monthly_revenue: currentRevenue,\n        average_pledge: currentRevenue / (apiResponse.data.attributes.patron_count || 1)\n      };\n    }\n    break;\n    \n  case \u0027shopify\u0027:\n    if (apiResponse.orders) {\n      currentRevenue = apiResponse.orders.reduce((sum, order) =\u003e {\n        return sum + parseFloat(order.total_price || 0);\n      }, 0);\n      metrics = {\n        order_count: apiResponse.orders.length,\n        total_revenue: currentRevenue,\n        average_order_value: currentRevenue / (apiResponse.orders.length || 1)\n      };\n    }\n    break;\n    \n  case \u0027printify\u0027:\n    if (apiResponse.data) {\n      currentRevenue = apiResponse.data.reduce((sum, order) =\u003e {\n        return sum + parseFloat(order.total_price || 0);\n      }, 0);\n      metrics = {\n        order_count: apiResponse.data.length,\n        total_revenue: currentRevenue,\n        average_order_value: currentRevenue / (apiResponse.data.length || 1)\n      };\n    }\n    break;\n    \n  case \u0027youtube\u0027:\n    if (apiResponse.items) {\n      // YouTube revenue estimation based on views (rough calculation)\n      const totalViews = apiResponse.items.reduce((sum, channel) =\u003e {\n        return sum + parseInt(channel.statistics.viewCount || 0);\n      }, 0);\n      currentRevenue = totalViews * 0.001; // Rough estimate: $1 per 1000 views\n      metrics = {\n        total_views: totalViews,\n        estimated_revenue: currentRevenue,\n        subscriber_count: apiResponse.items.reduce((sum, channel) =\u003e {\n          return sum + parseInt(channel.statistics.subscriberCount || 0);\n        }, 0)\n      };\n    }\n    break;\n    \n  default:\n    currentRevenue = 0;\n    metrics = { error: \u0027Unknown source type\u0027 };\n}\n\n// Calculate performance against target\nconst targetRevenue = sourceConfig.targetRevenue;\nconst performanceRatio = targetRevenue \u003e 0 ? (currentRevenue / targetRevenue) : 0;\nconst revenueGap = targetRevenue - currentRevenue;\n\n// Generate optimization recommendations\nconst recommendations = [];\n\nif (performanceRatio \u003c 0.5) {\n  recommendations.push({\n    priority: \u0027high\u0027,\n    category: \u0027revenue_gap\u0027,\n    action: `Significant revenue gap detected. Current: $${currentRevenue.toFixed(2)}, Target: $${targetRevenue.toFixed(2)}`,\n    impact: \u0027high\u0027\n  });\n}\n\nif (sourceConfig.source === \u0027patreon\u0027 \u0026\u0026 metrics.patron_count \u003c 100) {\n  recommendations.push({\n    priority: \u0027medium\u0027,\n    category: \u0027audience_growth\u0027,\n    action: \u0027Focus on growing Patreon subscriber base through exclusive content and community building\u0027,\n    impact: \u0027medium\u0027\n  });\n}\n\nif (sourceConfig.source === \u0027shopify\u0027 \u0026\u0026 metrics.average_order_value \u003c 50) {\n  recommendations.push({\n    priority: \u0027medium\u0027,\n    category: \u0027pricing_optimization\u0027,\n    action: \u0027Consider bundling products or increasing average order value through upselling\u0027,\n    impact: \u0027medium\u0027\n  });\n}\n\nreturn {\n  source: sourceConfig.source,\n  current_revenue: currentRevenue,\n  target_revenue: targetRevenue,\n  performance_ratio: performanceRatio,\n  revenue_gap: revenueGap,\n  metrics,\n  recommendations,\n  analysis_timestamp: sourceConfig.analysisTimestamp\n};"
                                     },
