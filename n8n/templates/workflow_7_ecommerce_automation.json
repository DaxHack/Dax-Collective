                      "id":  "split-platforms",
                      "name":  "Process Each Platform",
                      "type":  "n8n-nodes-base.splitInBatches",
                      "typeVersion":  3,
                      "position":  [
                                       680,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// Configure platform-specific analysis\nconst ecommerceData = $(\u0027Prepare E-commerce Analysis\u0027).first();\nconst currentPlatform = ecommerceData.enabledPlatforms[$(\u0027Process Each Platform\u0027).itemIndex];\n\nif (!currentPlatform) {\n  return null;\n}\n\nconst platformConfig = ecommerceData.ecommerceConfig[currentPlatform];\n\n// Platform-specific API configurations\nfunction getShopifyConfig(config) {\n  return {\n    platform: \u0027shopify\u0027,\n    baseUrl: `https://${config.shopDomain}.myshopify.com/admin/api/2023-10`,\n    headers: {\n      \u0027X-Shopify-Access-Token\u0027: config.accessToken,\n      \u0027Content-Type\u0027: \u0027application/json\u0027\n    },\n    endpoints: {\n      products: \u0027/products.json\u0027,\n      orders: \u0027/orders.json\u0027,\n      inventory: \u0027/inventory_levels.json\u0027,\n      analytics: \u0027/analytics/reports/orders.json\u0027\n    }\n  };\n}\n\nfunction getPrintifyConfig(config) {\n  return {\n    platform: \u0027printify\u0027,\n    baseUrl: \u0027https://api.printify.com/v1\u0027,\n    headers: {\n      \u0027Authorization\u0027: `Bearer ${config.apiKey}`,\n      \u0027Content-Type\u0027: \u0027application/json\u0027\n    },\n    endpoints: {\n      products: `/shops/${config.shopId}/products.json`,\n      orders: `/shops/${config.shopId}/orders.json`,\n      catalog: \u0027/catalog/blueprints.json\u0027\n    }\n  };\n}\n\nfunction getEtsyConfig(config) {\n  return {\n    platform: \u0027etsy\u0027,\n    baseUrl: \u0027https://openapi.etsy.com/v3/application\u0027,\n    headers: {\n      \u0027Authorization\u0027: `Bearer ${config.accessToken}`,\n      \u0027Content-Type\u0027: \u0027application/json\u0027\n    },\n    endpoints: {\n      products: `/shops/${config.shopId}/listings`,\n      orders: `/shops/${config.shopId}/receipts`,\n      analytics: `/shops/${config.shopId}/stats`\n    }\n  };\n}\n\n// Get configuration for current platform\nlet apiConfig;\nswitch (currentPlatform) {\n  case \u0027shopify\u0027:\n    apiConfig = getShopifyConfig(platformConfig);\n    break;\n  case \u0027printify\u0027:\n    apiConfig = getPrintifyConfig(platformConfig);\n    break;\n  case \u0027etsy\u0027:\n    apiConfig = getEtsyConfig(platformConfig);\n    break;\n  default:\n    return null;\n}\n\nreturn {\n  ...apiConfig,\n  brandStrategies: ecommerceData.brandStrategies,\n  automationTasks: ecommerceData.automationTasks,\n  analysisTimestamp: ecommerceData.analysisTimestamp\n};"
                                     },
