                                   ],
                      "webhookId":  "content-generation"
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// Multiformat Content Generator\n// Processes video content and generates platform-specific content\n\nconst videoData = $input.first();\n\n// Validate input data\nif (!videoData.videoId || !videoData.brand || !videoData.title) {\n  throw new Error(\u0027Invalid video data received\u0027);\n}\n\n// Brand-specific content strategies\nconst brandStrategies = {\n  dax_traveler: {\n    platforms: [\u0027instagram\u0027, \u0027facebook\u0027, \u0027twitter\u0027, \u0027linkedin\u0027, \u0027tiktok\u0027, \u0027blog\u0027],\n    tone: \u0027personal, adventurous, inspiring\u0027,\n    hashtags: [\u0027#DaxTheTraveler\u0027, \u0027#TravelAdventure\u0027, \u0027#Wanderlust\u0027, \u0027#TravelVlog\u0027],\n    cta: \u0027Join the Traveler\\\u0027s Club on Patreon for exclusive content!\u0027,\n    affiliateOpportunities: [\u0027travel gear\u0027, \u0027booking platforms\u0027, \u0027travel insurance\u0027]\n  },\n  timezone_travelers: {\n    platforms: [\u0027instagram\u0027, \u0027facebook\u0027, \u0027twitter\u0027, \u0027pinterest\u0027, \u0027blog\u0027],\n    tone: \u0027informative, helpful, professional\u0027,\n    hashtags: [\u0027#TimezoneTravel\u0027, \u0027#TravelTips\u0027, \u0027#TravelGuide\u0027, \u0027#TravelHacks\u0027],\n    cta: \u0027Get our complete travel guides and itineraries!\u0027,\n    affiliateOpportunities: [\u0027travel guides\u0027, \u0027booking platforms\u0027, \u0027travel apps\u0027]\n  },\n  gods_vessel: {\n    platforms: [\u0027instagram\u0027, \u0027facebook\u0027, \u0027twitter\u0027, \u0027pinterest\u0027, \u0027blog\u0027],\n    tone: \u0027inspirational, faithful, encouraging\u0027,\n    hashtags: [\u0027#GodsVessel\u0027, \u0027#Faith\u0027, \u0027#ChristianLife\u0027, \u0027#Inspiration\u0027],\n    cta: \u0027Shop faith-inspired apparel at God\\\u0027s Vessel!\u0027,\n    affiliateOpportunities: [\u0027christian books\u0027, \u0027devotionals\u0027, \u0027faith merchandise\u0027]\n  },\n  ani_dax: {\n    platforms: [\u0027instagram\u0027, \u0027facebook\u0027, \u0027twitter\u0027, \u0027tiktok\u0027, \u0027reddit\u0027],\n    tone: \u0027enthusiastic, knowledgeable, community-focused\u0027,\n    hashtags: [\u0027#AniDax\u0027, \u0027#Anime\u0027, \u0027#Manga\u0027, \u0027#AnimeReview\u0027, \u0027#Otaku\u0027],\n    cta: \u0027Join our anime community for reviews and recommendations!\u0027,\n    affiliateOpportunities: [\u0027anime merchandise\u0027, \u0027manga\u0027, \u0027streaming services\u0027]\n  }\n};\n\nconst strategy = brandStrategies[videoData.brand];\nif (!strategy) {\n  throw new Error(`Unknown brand: ${videoData.brand}`);\n}\n\n// Prepare content generation data\nconst contentData = {\n  ...videoData,\n  strategy,\n  generationTimestamp: new Date().toISOString(),\n  contentId: `${videoData.brand}_${videoData.videoId}_${Date.now()}`\n};\n\nreturn contentData;"
                                     },
                      "id":  "prepare-content-data",
                      "name":  "Prepare Content Data",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       460,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
