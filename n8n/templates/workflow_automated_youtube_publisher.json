          "id": "1",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "1",
              "leftValue": "={{$json['Upload Status']}}",
              "rightValue": "Approved",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "2",
              "leftValue": "={{$json['Platform']}}",
              "rightValue": "YouTube",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            },
            {
              "id": "3",
              "leftValue": "={{new Date($json['Scheduled Date']).getTime()}}",
              "rightValue": "={{new Date().getTime()}}",
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
