{
  "name": "dax-collective",
  "version": "1.0.0",
  "private": true,
  "description": "Dax Collective - Multi-brand platform with travel, faith, and creative content",
  "scripts": {
    "dev": "concurrently \"npm --prefix dax-backend start\" \"npm --prefix dax-main start\"",
    "start": "npm run dev",
    "build": "npm --prefix dax-main run build",
    "anidax:sample": "node tools/anidax/produce-sample.mjs",
    "gods-vessel:collection": "node tools/gods-vessel/produce-names-of-god.mjs",
    "timezone:sample": "node tools/timezone-travelers/produce-sample.mjs",
    "dax-traveler:support": "node tools/dax-traveler/produce-support-package.mjs",
    "revenue:readiness": "node tools/revenue-readiness/build-readiness.mjs",
    "business-state:build": "node tools/business-state/build-state.mjs",
    "business-state:query": "node tools/business-state/query-state.mjs",
    "n8n:inventory": "node tools/n8n/inventory.mjs",
    "install:all": "npm install && npm --prefix dax-main install && npm --prefix dax-backend install && npm --prefix functions install",
    "clean": "rimraf node_modules dax-main/node_modules dax-backend/node_modules functions/node_modules",
    "deploy": "firebase deploy",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "rimraf": "^5.0.10"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DaxHack/Dax-Collective.git"
  },
  "author": "Dax Collective",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.0.1"
  }
}
