# dax-main/.env.example
# Frontend React application environment variables (SAFE TEMPLATE)
# All values here are placeholders. Set real values via Replit Secrets ONLY.
# NEVER commit real API keys, tokens, or credentials to version control.

# =============================================================================
# DEVELOPMENT SERVER
# =============================================================================
PORT=5000
HOST=0.0.0.0
BROWSER=none
DANGEROUSLY_DISABLE_HOST_CHECK=true
NODE_ENV=development
REACT_APP_DEBUG=true

# Backend API base URL (backend runs on port 3001)
REACT_APP_API_BASE_URL=http://localhost:3001

# =============================================================================
# FIREBASE CLIENT CONFIG (frontend-safe public values)
# =============================================================================
REACT_APP_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
REACT_APP_FIREBASE_AUTH_DOMAIN=dax-collective.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=dax-collective
REACT_APP_FIREBASE_STORAGE_BUCKET=dax-collective.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
REACT_APP_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
REACT_APP_FIREBASE_MEASUREMENT_ID=G-KVXQJ21CZW

# =============================================================================
# GOOGLE API KEYS (browser-restricted only)
# Set Application restrictions to HTTP referrers with your domain(s).
# =============================================================================
REACT_APP_GOOGLE_API_KEY=YOUR_RESTRICTED_BROWSER_GOOGLE_KEY
REACT_APP_YOUTUBE_API_KEY=YOUR_RESTRICTED_BROWSER_YOUTUBE_KEY

# =============================================================================
# GOOGLE SHEET IDs (public content sources)
# These are document IDs — not secrets. Make each sheet publicly viewable.
# =============================================================================
REACT_APP_SHEET_GODS_VESSEL_QUOTES=YOUR_GODS_VESSEL_SHEET_ID
REACT_APP_SHEET_DAX_TRAVELER_BLOGS=YOUR_DAX_TRAVELER_SHEET_ID
REACT_APP_SHEET_TIMEZONE_TRAVELERS_BLOGS_ITINERARIES=YOUR_TZ_TRAVELERS_SHEET_ID
REACT_APP_SHEET_GODS_VESSEL_DISCUSSIONS=YOUR_GODS_VESSEL_DISCUSSIONS_SHEET_ID
REACT_APP_SHEET_TSHIRT_DESIGNS_CANVA_BULK=YOUR_TSHIRT_DESIGNS_SHEET_ID
REACT_APP_SHEET_SATIATED_TASTE_RECIPES=YOUR_RECIPES_SHEET_ID
REACT_APP_SHEET_BRAND_ANALYTICS_DASHBOARD=YOUR_ANALYTICS_SHEET_ID
REACT_APP_SHEET_SOCIAL_TRACKING_YOUTUBE=YOUR_SOCIAL_TRACKING_YOUTUBE_SHEET_ID
REACT_APP_SHEET_SOCIAL_TRACKING_INSTAGRAM=YOUR_SOCIAL_TRACKING_INSTAGRAM_SHEET_ID
REACT_APP_SHEET_SOCIAL_TRACKING_TIKTOK=YOUR_SOCIAL_TRACKING_TIKTOK_SHEET_ID
REACT_APP_SHEET_SOCIAL_TRACKING_TWITTER=YOUR_SOCIAL_TRACKING_TWITTER_SHEET_ID
REACT_APP_SHEET_SOCIAL_TRACKING_FACEBOOK=YOUR_SOCIAL_TRACKING_FACEBOOK_SHEET_ID

# =============================================================================
# GOOGLE DRIVE FOLDER IDs (public read access)
# =============================================================================
REACT_APP_DRIVE_DAX_TRAVELER_PHOTOS=YOUR_DRIVE_FOLDER_ID
REACT_APP_DRIVE_GODS_VESSEL_PHOTOS=YOUR_DRIVE_FOLDER_ID
REACT_APP_DRIVE_TIMEZONE_TRAVELERS_PHOTOS=YOUR_DRIVE_FOLDER_ID
REACT_APP_DRIVE_ANI_DAX_PHOTOS=YOUR_DRIVE_FOLDER_ID
REACT_APP_DRIVE_DAX_HOMEPAGE_PHOTOS=YOUR_DRIVE_FOLDER_ID
REACT_APP_DRIVE_DAX_ANALYTICS_IMAGES=YOUR_DRIVE_FOLDER_ID
REACT_APP_DRIVE_TSHIRT_DESIGNS=YOUR_DRIVE_FOLDER_ID
REACT_APP_DRIVE_LOGO_ASSETS=YOUR_DRIVE_FOLDER_ID
REACT_APP_DRIVE_BRAND_ASSETS=YOUR_DRIVE_FOLDER_ID
REACT_APP_DRIVE_YOUTUBE_THUMBNAILS=YOUR_DRIVE_FOLDER_ID
REACT_APP_DRIVE_SOCIAL_MEDIA_ASSETS=YOUR_DRIVE_FOLDER_ID
REACT_APP_DRIVE_BLOG_IMAGES=YOUR_DRIVE_FOLDER_ID
REACT_APP_DRIVE_BACKUP_PHOTOS=YOUR_DRIVE_FOLDER_ID
REACT_APP_DRIVE_ARCHIVE_PHOTOS=YOUR_DRIVE_FOLDER_ID
REACT_APP_DRIVE_SATIATED_TASTE_PHOTOS=YOUR_DRIVE_FOLDER_ID

# =============================================================================
# YOUTUBE CHANNEL IDs (public)
# =============================================================================
REACT_APP_YOUTUBE_CHANNEL_ID_DAX_TRAVELER=UCuN9RFxD1_PUOci_AEa5DMQ
REACT_APP_YOUTUBE_CHANNEL_ID_TIMEZONE_TRAVELERS=UCKan3hAUmcy0Q49d7MIXhdA
REACT_APP_YOUTUBE_CHANNEL_ID_SATIATED_TASTE=UCmlTPphxXdZ3T2gDQ_kPZQQ
REACT_APP_YOUTUBE_CHANNEL_ID_GODS_VESSEL=UCAzuegEphw7oQRarESOjuqA

# =============================================================================
# EXTERNAL APIs (browser-safe keys only)
# =============================================================================
REACT_APP_UNSPLASH_ACCESS_KEY=YOUR_UNSPLASH_KEY
REACT_APP_PEXELS_API_KEY=YOUR_PEXELS_KEY
REACT_APP_PIXABAY_API_KEY=YOUR_PIXABAY_KEY

# =============================================================================
# SOCIAL & ANALYTICS
# =============================================================================
REACT_APP_GA_MEASUREMENT_ID=G-KVXQJ21CZW
REACT_APP_MIXPANEL_TOKEN=YOUR_MIXPANEL_TOKEN
REACT_APP_HOTJAR_SITE_ID=YOUR_HOTJAR_SITE_ID
REACT_APP_REDDIT_CLIENT_ID=YOUR_REDDIT_CLIENT_ID
REACT_APP_REDDIT_SUBREDDIT_DAX_TRAVELER=
REACT_APP_REDDIT_SUBREDDIT_TIMEZONE_TRAVELERS=
REACT_APP_REDDIT_SUBREDDIT_SATIATED_TASTE=
REACT_APP_REDDIT_SUBREDDIT_GODS_VESSEL=

# =============================================================================
# N8N AUTOMATION
# =============================================================================
REACT_APP_N8N_WEBHOOK_URL=http://localhost:5678
REACT_APP_N8N_API_KEY=YOUR_N8N_API_KEY
REACT_APP_N8N_WEBHOOK_CONTENT_GENERATION=
REACT_APP_N8N_WEBHOOK_SOCIAL_DISTRIBUTION=
REACT_APP_N8N_WEBHOOK_YOUTUBE_SYNC=
REACT_APP_N8N_WEBHOOK_REVENUE_OPTIMIZATION=

# =============================================================================
# AI / VOICE
# =============================================================================
# IMPORTANT: AI provider keys (OpenAI, ElevenLabs, Claude, etc.) must NEVER be
# exposed to the frontend. Keep them backend-only (no REACT_APP_ prefix).
# The frontend should call your backend API for any AI-powered features.
# REACT_APP_OPENAI_API_KEY=DO_NOT_USE
# REACT_APP_ELEVENLABS_API_KEY=DO_NOT_USE
REACT_APP_VOICE_ID_DAX_TRAVELER=
REACT_APP_VOICE_ID_TIMEZONE_TRAVELERS=
REACT_APP_VOICE_ID_SATIATED_TASTE=
REACT_APP_VOICE_ID_GODS_VESSEL=

# =============================================================================
# EMAIL ADDRESSES
# =============================================================================
REACT_APP_EMAIL_MAIN=
REACT_APP_EMAIL_DAX_TRAVELER=
REACT_APP_EMAIL_TIMEZONE_TRAVELERS=
REACT_APP_EMAIL_SATIATED_TASTE=
REACT_APP_EMAIL_GODS_VESSEL=
REACT_APP_EMAIL_SUPPORT=
REACT_APP_EMAIL_BUSINESS=

# =============================================================================
# FEATURE TOGGLES
# =============================================================================
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_DEBUG_LOGS=true
REACT_APP_ENABLE_SERVICE_WORKER=true
REACT_APP_API_TIMEOUT=30000
