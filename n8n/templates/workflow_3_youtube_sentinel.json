                      "type":  "n8n-nodes-base.splitInBatches",
                      "typeVersion":  3,
                      "position":  [
                                       680,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "url":  "https://www.googleapis.com/youtube/v3/search",
                                         "sendQuery":  true,
                                         "queryParameters":  {
